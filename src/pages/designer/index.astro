---
// Designer: everything a hotel can design for itself, then the towel studio to build it.
import Base from '../../layouts/Base.astro';
import heroes from '../../data/heroes.json';
import PageHero from '../../components/PageHero.astro';
import { Image, getImage } from 'astro:assets';
import ProductShowcase from '../../components/ProductShowcase.jsx';
import { collections, ranges } from '../../data/catalogue';
import { pick } from '../../data/shoot';
import rollsGarden from '../../assets/hero/rolls-garden.jpg';
// The parts of a towel a hotel can make its own. (Our ready jacquard designs now live in the Lookbook.)
// The six ranges for the spinning carousel / accordion (switchable at the side).
// Six robes, cropped so every face sits at the same point: centred across, 30% down (src/assets/robes/).
const robeShots = import.meta.glob<{ default: ImageMetadata }>('../../assets/robes/*.jpg', { eager: true });
const robes: [string, string, string, string][] = [
  ['white', 'White terry', 'Bath Robe', '/ranges/bath-robe/'], ['navy', 'Navy', 'Bath Robe', '/ranges/bath-robe/'],
  ['grey', 'Grey', 'Bath Robe', '/ranges/bath-robe/'], ['blush', 'Blush stripe', 'Bath Robe', '/ranges/bath-robe/'],
  ['leopard', 'Leopard', 'Bamboo Safari', '/ranges/bamboo-safari/'], ['zebra', 'Zebra', 'Bamboo Safari', '/ranges/bamboo-safari/'],
];
const rangeItems = await Promise.all(robes.map(async ([file, name, sub, href]) => {
  const src = robeShots[`../../assets/robes/${file}.jpg`].default;
  return { name, sub, href, image: (await getImage({ src, width: 1400, format: 'webp' })).src, thumb: (await getImage({ src, width: 480, format: 'webp' })).src };
}));
const tailor = { title: 'Tailor-made', kicker: 'Your crest, woven in', image: pick('product-closeup', 'j8a2346'), href: '/request-a-quote/' };
---
<Base title="Designer Collection · Emsworth Hospitality" overHero
  description="Design your own hotel towels: jacquard patterns woven to your artwork, borders, Pantone colours, woven labels and packaging, sampled for your approval.">
  <PageHero tune={(heroes as any).designer} image={rollsGarden} alt="Rolled Emsworth towels in their belly bands on a stack of jacquard towels, in a garden" focus="50% 40%" plain
  kicker="Designer Collection" title="Woven,<br/><em>not printed.</em>"
    intro="Your pattern woven in, your border, your Pantone, your labels and your packaging. Tell us the brief and we sample it for you."
    crumbs={[["Home", "/"]]} />

  <!-- Collections -->
  <section class="sec sec--ground">
    <div class="wrap">
      <div class="sec__head sec__head--center reveal">
        <span class="orn"></span>
        <span class="label">The collections</span>
        <h2>Every textile a guest touches</h2>
      </div>
      <div class="cols" data-rows>
        {[...collections.map((c) => ({ title: c.name, kicker: c.kicker, image: c.image, href: `/collections/${c.slug}/` })), tailor].map((c, i) => (
          <a class="col reveal" href={c.href} style={`--d:${i * 60}ms`} data-ar={(c.image.width / c.image.height).toFixed(4)}>
            <div class="col__img" style={`aspect-ratio: ${c.image.width} / ${c.image.height}`}><Image src={c.image} alt="" widths={[420, 720, 1100]} sizes="(max-width: 700px) 92vw, 45vw" /></div>
            <span class="label">{c.kicker}</span>
            <span class="col__row"><h3>{c.title}</h3><span class="link link--icon">Discover the collection</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- Ranges: heading and all six photos in one screen -->
  <section class="sec ranges1">
    <div class="wrap">
      <div class="sec__head reveal">
        <span class="orn"></span>
        <span class="label">The robes</span>
        <h2>Six robes, <em>photographed in full</em></h2>
        <p class="lead">From hotel white terry to safari jacquard. Every robe can be dyed to your Pantone and finished with your crest.</p>
      </div>
      <ProductShowcase client:only="react" items={rangeItems} modes={["accordion"]} />
    </div>
  </section>


</Base>

<style>
  /* Six ranges: one screen below the header. Heading and line side by side, the accordion takes the rest. */
  .ranges1 { display: flex; flex-direction: column; justify-content: center; min-height: calc(100svh - 84px); padding-block: clamp(20px, 3.5vh, 40px); }
  .ranges1 .sec__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 40ch); align-items: end; gap: 12px 48px; max-width: none; margin-bottom: clamp(16px, 2.6vh, 28px); }
  .ranges1 .sec__head > :not(h2):not(.lead) { grid-column: 1; }
  .ranges1 .sec__head h2 { grid-column: 1; margin: 0; font-size: clamp(38px, 4.2vw, 64px); line-height: 1; }
  .ranges1 .sec__head .lead { grid-column: 2; grid-row: span 3; align-self: end; margin: 0; }
  .ranges1 :global(.accordion-gallery) { height: calc(100svh - 84px - 2 * clamp(20px, 3.5vh, 40px) - clamp(16px, 2.6vh, 28px) - clamp(110px, 15vh, 150px)) !important; min-height: 380px; }
  .ranges1 :global(.showcase) { margin-top: 0; }
  @media (max-width: 860px) {
    .ranges1 { min-height: 0; }
    .ranges1 .sec__head { grid-template-columns: 1fr; }
    .ranges1 .sec__head .lead { grid-column: 1; grid-row: auto; }
    .ranges1 :global(.accordion-gallery) { height: 520px !important; }
  }
  .cols { display: flex; flex-wrap: wrap; gap: clamp(30px, 3vw, 44px) clamp(18px, 2.4vw, 34px); }
  .col { display: grid; gap: 8px; justify-items: start; align-content: start; width: calc(33.333% - 23px); text-decoration: none; transition-delay: var(--d); }
  /* Soft rounded (from Sharan's main-branch update): rounded photo, soft shadow that deepens and lifts on hover. */
  .col__img { width: 100%; overflow: hidden; margin-bottom: 10px; border-radius: 18px; box-shadow: 0 14px 30px -22px rgba(7, 40, 38, .5); transition: transform .6s cubic-bezier(.22, 1, .36, 1), box-shadow .6s; }
  .col:hover .col__img { transform: translateY(-4px); box-shadow: 0 30px 50px -26px rgba(7, 40, 38, .55); }
  .col__row { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; }
  .col__row h3 { margin: 0; }
  .col__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .col:hover .col__img img { transform: scale(1.04); }
  .col h3 { font-size: clamp(28px, 2.6vw, 38px); }
</style>

<script>
  import { justifyAll } from '../../scripts/justify';
  // The collections: whole photographs in rows, three to a row on desktop, two on a tablet, one on a phone.
  justifyAll('.cols[data-rows]', { target: () => (innerWidth > 1100 ? 480 : 380), maxPerRow: () => (innerWidth > 860 ? 3 : innerWidth > 600 ? 2 : 1) });
</script>
