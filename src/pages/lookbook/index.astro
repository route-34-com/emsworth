---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { pick } from '../../data/shoot';
import { CATEGORIES, tagged } from '../../data/colours';

// The lookbook: one photograph per product, each shown whole in its own shape; rows are scaled to fill the width (see justify.ts).
const items = CATEGORIES.map((c) => ({ ...c, n: tagged.filter((p) => p.cat === c.id).length, img: pick(...c.cover) }));
if (items.reduce((n, c) => n + c.n, 0) !== tagged.length) throw new Error('Lookbook products do not cover every photo');
---
<Base title="Lookbook · Emsworth Hospitality"
  description={`The Emsworth lookbook: bathrobes, towels, bath mats, slippers, bed and table linen.`}>
  <section class="looks wrap">
    <header class="looks__head">
      <span class="label">The lookbook</span>
      <h1>Choose a <em>product.</em></h1>
    </header>

    <div class="rows" data-rows>
      {items.map((c, i) => (
        <a class="card" href={`/lookbook/${c.id}/`} data-ar={(c.img.width / c.img.height).toFixed(4)}>
          <span class="card__img" style={`aspect-ratio: ${c.img.width} / ${c.img.height}`}>
            <Image src={c.img} alt="" widths={[480, 800, 1400]} sizes="(max-width: 640px) 60vw, 40vw" loading={i < 4 ? 'eager' : 'lazy'} />
          </span>
          <span class="card__cap"><b>{c.name}</b><span class="link link--icon">Discover</span></span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .looks { padding-top: clamp(36px, 5vw, 70px); padding-bottom: 110px; }
  .looks__head { margin-bottom: 34px; }
  .looks h1 { font-size: clamp(38px, 5vw, 68px); margin: 10px 0 0; }

  /* Each photo whole, in its own shape; the script sets widths so every row fills the line. */
  .rows { display: flex; flex-wrap: wrap; gap: clamp(28px, 3vw, 44px) clamp(14px, 1.6vw, 24px); }
  .card { display: flex; flex-direction: column; gap: 14px; text-decoration: none; color: var(--ink); width: calc(33.333% - 16px); }
  /* Soft rounded, a touch tighter than the home cards so the dense grid doesn't look bubbly. */
  .card__img { position: relative; display: block; overflow: hidden; background: var(--tint); border-radius: 14px; box-shadow: 0 12px 26px -20px rgba(7, 40, 38, .5); transition: transform .6s cubic-bezier(.22, 1, .36, 1), box-shadow .6s; }
  .card:hover .card__img { transform: translateY(-4px); box-shadow: 0 26px 44px -24px rgba(7, 40, 38, .55); }
  .card__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .card:hover .card__img img { transform: scale(1.03); }
  .card__cap { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); transition: border-color .4s; }
  .card:hover .card__cap { border-color: var(--accent); }
  .card__cap b { font: var(--fdw) clamp(20px, 2vw, 30px)/1.1 var(--fd); }
  .card__cap .link { white-space: nowrap; }

  @media (max-width: 760px) {
    .rows { gap: 26px 10px; }
    .card__cap { flex-direction: column; gap: 4px; }
    .card__cap b { font-size: 19px; }
    .card__cap .link { font-size: 10px; gap: 8px; } .card__cap .link::after { width: 32px; height: 32px; background-size: 14px 14px; }
  }
</style>

<script>
  import { justifyAll } from '../../scripts/justify';
  // Row height to aim for: tall on desktop, shorter on phones; at most three products to a row (two on a phone).
  justifyAll('[data-rows]', { target: () => (innerWidth > 1100 ? 440 : innerWidth > 640 ? 340 : 250), maxPerRow: () => (innerWidth > 640 ? 3 : 2) });
</script>
