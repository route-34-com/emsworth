---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { COLOURS, CATEGORIES, STYLE_NAMES, STYLE_ORDER, tagged } from '../../data/colours';
import Pic from '../../components/Pic.astro';
import { PATTERNS } from '../../data/main';

// One product from the lookbook, colour by colour and, within a colour, style by style; then "made in your colour".
export function getStaticPaths() {
  return CATEGORIES.map((c, i) => ({ params: { cat: c.id }, props: { c, prev: CATEGORIES[(i - 1 + CATEGORIES.length) % CATEGORIES.length], next: CATEGORIES[(i + 1) % CATEGORIES.length] } }));
}
type Cat = (typeof CATEGORIES)[number];
interface Props { c: Cat; prev: Cat; next: Cat }
const { c, prev, next } = Astro.props;
const mine = tagged.filter((p) => p.cat === c.id);
const full = new Map(await Promise.all(mine.map(async (p) => [p, (await getImage({ src: p.src, width: 1600, format: 'webp' })).src] as const)));
// Every photo in one gallery, ordered colour by colour and style by style; a filter bar narrows it by design and colour.
const chip = (k: { id: string; hex: string; two?: boolean }) =>
  k.id === 'mixed' ? 'background: radial-gradient(circle, #f3ead6 0 30%, transparent 33%), conic-gradient(#a6472b 0 25%, #24479b 0 50%, #7ba477 0 75%, #1c1c1c 0)'
  : k.two ? `background: radial-gradient(circle, #f3ead6 0 34%, ${k.hex} 37%)` : `background: ${k.hex}`;
// Our own towel designs (bath only) sit in the same gallery: their colourways mapped onto the lookbook colours and designs.
const designs = c.id === 'bath' ? PATTERNS : [];
const CW_COLOUR: Record<string, string> = { navy: 'navy', terracotta: 'rust', sage: 'sage', onyx: 'black', white: 'white', ivory: 'ivory', natural: 'ivory',
  sand: 'tan', blush: 'pink', olive: 'olive', slate: 'grey', charcoal: 'charcoal', leopard: 'tan', 'snow-leopard': 'black', zebra: 'black' };
const designOf = (pat: string, key: string) => (pat === 'animal' ? key : pat);
const DESIGN_NAMES: Record<string, string> = { ...STYLE_NAMES, swirl: 'Swirl', harlequin: 'Harlequin' };
const colours = COLOURS.filter((col) => mine.some((p) => p.col === col.id) || designs.some((d) => d.colourways.some((cw) => CW_COLOUR[cw.key] === col.id)));
const styles = [...STYLE_ORDER.filter((st) => mine.some((p) => p.style === st)), ...['swirl', 'harlequin'].filter((d) => designs.some((x) => x.slug === d))];
const ordered = colours.flatMap((col) => styles.flatMap((st) => mine.filter((p) => p.col === col.id && p.style === st)));
const colOf = (id: string) => colours.find((x) => x.id === id)!;
const capOf = (p: (typeof mine)[number]) => (styles.length > 1 && colours.length > 1 ? `${colOf(p.col).name} · ${STYLE_NAMES[p.style]}` : colours.length > 1 ? colOf(p.col).name : STYLE_NAMES[p.style]);
// One tile per design in a colour; the rest open with it in the viewer.
let groupsOf = colours.flatMap((col) => styles.map((st) => ordered.filter((p) => p.col === col.id && p.style === st))).filter((g) => g.length);
// The cover is the towel itself when most designs here have a product-only photo (or when our own designs are in the grid);
// otherwise a photo with the model. Model photos then follow as the other views.
const towelFirst = designs.length > 0 || groupsOf.filter((g) => g.some((p) => !p.person)).length > groupsOf.length / 2;
groupsOf = groupsOf.map((g) => [...g].sort((x, y) => (towelFirst ? Number(x.person) - Number(y.person) : Number(y.person) - Number(x.person))));
// Towel-only close-ups cut from a model photo, for a design that has no product-only shot (src/assets/closeups/<cat>-<colour>-<style>.jpg).
const closeups = import.meta.glob<{ default: ImageMetadata }>('../../assets/closeups/*.jpg', { eager: true });
const closeupOf = (col: string, st: string) => closeups[`../../assets/closeups/${c.id}-${col}-${st}.jpg`]?.default;
type View = { href: string; cap: string };
type Tile = { d: string; c: string; ar: number; cap: string; dot: string; cover: { pic?: string; img?: ImageMetadata; alt: string }; views: View[]; link?: string };
const tiles: Tile[] = [
  // Our designs: the folded towel is the cover; its set, close-up and face-towel views, then any shoot photos of the same design and colour.
  ...designs.flatMap((pat) => pat.colourways.map((cw) => {
    const d = designOf(pat.slug, cw.key), col = CW_COLOUR[cw.key];
    const shoot = groupsOf.find((g) => g[0].style === d && g[0].col === col);
    if (shoot) groupsOf = groupsOf.filter((g) => g !== shoot);
    const own = [cw.fold, cw.set, cw.detail, cw.face, cw.slipper].filter(Boolean) as string[];
    const big = (v: string) => `/images/${v}-${v.includes('-face') ? 1400 : 1600}.webp`;
    const cap = `${pat.name} · ${cw.name}`;
    return { d, c: col, ar: 1, cap, dot: `background: ${cw.hex}`, link: `/lookbook/bath/${pat.slug}/?c=${cw.key}`,
      cover: { pic: cw.fold, alt: `${pat.name} ${cw.name} towel, folded` },
      views: [...own.map((v) => ({ href: big(v), cap: `${c.name} · ${cap}` })), ...(shoot ?? []).map((q) => ({ href: full.get(q)!, cap: `${c.name} · ${capOf(q)}` }))] };
  })),
  ...groupsOf.map((g) => {
    const close = towelFirst && g.every((p) => p.person) ? closeupOf(g[0].col, g[0].style) : undefined;
    const coverImg = close ?? g[0].src;
    return { d: g[0].style, c: g[0].col, ar: coverImg.width / coverImg.height, cap: capOf(g[0]), dot: chip(colOf(g[0].col)),
      cover: { img: coverImg, alt: `${c.one}, ${capOf(g[0]).toLowerCase()}` },
      views: [...(close ? [{ href: close.src, cap: `${c.name} · ${capOf(g[0])}` }] : []), ...g.map((q) => ({ href: full.get(q)!, cap: `${c.name} · ${capOf(q)}` }))] };
  }),
];
const SHOW = 24; // photos shown before "Show more"

// Hotel shades offered as a starting point, light to dark by family; the last button opens the full picker.
const shades: [string, string][] = [
  ['Ivory', '#e9dcc0'], ['Sand', '#d6c2a0'], ['Camel', '#b98a5e'], ['Stone', '#a59d90'], ['Dove grey', '#b9bcbf'], ['Charcoal', '#3d3c41'],
  ['Blush', '#e6b8ae'], ['Dusty rose', '#c48b8b'], ['Terracotta', '#a8553a'], ['Saffron', '#d9822b'], ['Mustard', '#c9a227'], ['Claret', '#6d2235'],
  ['Sage', '#8fa98a'], ['Olive', '#76803a'], ['Bottle green', '#1f4a3c'], ['Teal', '#127b75'], ['Aqua', '#7fbfbf'], ['Dusk blue', '#56708f'],
  ['Cobalt', '#2c4f9e'], ['Midnight', '#1f2a44'], ['Lavender', '#a99bc9'], ['Aubergine', '#4a2c48'], ['Mocha', '#6b4f3f'], ['Black', '#1b1b1d'],
];
---
<Base title={`${c.name} · Lookbook · Emsworth Hospitality`}
  description={`${c.name} from the Emsworth shoot, by colour and style. Or have them dyed to your own Pantone.`}>
  <section class="room wrap">
    <header class="room__head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/lookbook/">Lookbook</a><span>/</span>{c.name}</nav>
      <h1>{c.name}</h1>
      <a class="room__own" href="#own">Made in your colour</a>
    </header>

    <section class="lf" data-lf data-page={SHOW}>
      {(
        <div class="lf__bar" role="toolbar" aria-label="Filter the photos">
          {styles.length > 1 && (
            <div class="lf__group" data-lf-key="d">
              <button type="button" class="on" data-v="all">All designs</button>
              {styles.map((st) => <button type="button" data-v={st}>{DESIGN_NAMES[st]}</button>)}
            </div>
          )}
          {colours.length > 1 && (
            <div class="lf__group" data-lf-key="c">
              <button type="button" class="on" data-v="all">All colours</button>
              {colours.map((col) => <button type="button" class="dot" data-v={col.id} style={chip(col).replace('background', '--chip')} aria-label={col.name} title={col.name}></button>)}
            </div>
          )}
          <a class="lf__custom" href="#own" title="Customise (coming soon)">Customise</a>
        </div>
      )}
      <div class="gal gal--flow" data-justify data-lf-items>
        {tiles.map((t, i) => (
          <div class="tile" data-gallery data-ar={t.ar.toFixed(4)} data-d={t.d} data-c={t.c} hidden={i >= SHOW}>
            <a class="tile__img" href={t.views[0].href} data-full data-cap={t.views[0].cap} style={`aspect-ratio: ${t.ar}`}>
              {t.cover.img
                ? <Image src={t.cover.img} alt={t.cover.alt} widths={[400, 800, 1200]} sizes="(max-width: 640px) 60vw, 34vw" loading="lazy" />
                : <Pic src={t.cover.pic!} alt={t.cover.alt} sizes="(max-width: 640px) 60vw, 25vw" />}
              {t.views.length > 1 && <span class="tile__more" aria-hidden="true">More views</span>}
            </a>
            {t.views.slice(1).map((v) => <a class="tile__extra" href={v.href} data-full data-cap={v.cap} aria-label="Another view"></a>)}
            <span class="tile__row">
              {t.link ? <a class="tile__cap" href={t.link} title={t.cap}><i style={t.dot}></i>{t.cap}</a> : <span class="tile__cap" title={t.cap}><i style={t.dot}></i>{t.cap}</span>}
              <a class="tile__custom" href="#own" title="Customise (coming soon)">Customise</a>
            </span>
          </div>
        ))}
      </div>
      <button class="more" type="button" data-lf-more hidden={tiles.length <= SHOW}>Show more</button>
    </section>
  </section>

  <section class="own" id="own" data-own data-cat={c.id} data-cat-name={c.name}>
    <div class="own__in wrap">
      <figure class="own__swatch">
        <figcaption><span data-own-name>Sage</span><small data-own-hex>#8FA98A</small></figcaption>
      </figure>

      <div class="own__form">
        <span class="orn"></span>
        <span class="label">Made in your colour</span>
        <h2>Any shade, <em>dyed to your Pantone.</em></h2>

        <div class="shades" role="radiogroup" aria-label="Choose a shade">
          {shades.map(([n, hex]) => (
            <button role="radio" aria-checked={n === 'Sage' ? 'true' : 'false'} data-shade={hex} data-name={n} style={`--c:${hex}`} aria-label={n} title={n}></button>
          ))}
          <label class="shades__own" title="Any colour">
            <input type="color" value="#8fa98a" data-own-color aria-label="Any colour" />
          </label>
        </div>

        <label class="own__field">
          <input type="text" placeholder="Pantone reference, e.g. 19-4052 TCX" data-own-pantone autocomplete="off" aria-label="Pantone reference" />
        </label>

        <ul class="own__terms">
          <li><b>Piece dyed</b>from 500 pcs · +7 days</li>
          <li><b>Yarn dyed</b>from 1,000 pcs · +14 days</li>
          <li><b>Lab dip</b>for your approval first</li>
        </ul>

        <button class="add" data-add="" data-name="" data-group="Custom colour" data-own-add>+ Add to quote</button>
      </div>
    </div>
  </section>

  <nav class="pn wrap" aria-label="Other products">
    <a href={`/lookbook/${prev.id}/`}><small>Previous</small>{prev.name}</a>
    <a href="/lookbook/" class="pn__all">All products</a>
    <a href={`/lookbook/${next.id}/`}><small>Next</small>{next.name}</a>
  </nav>
</Base>

<style>
  .room { padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(60px, 8vw, 110px); }
  .room__head { margin-bottom: 10px; }
  .crumbs { font: 600 12px var(--fb); letter-spacing: .14em; text-transform: uppercase; color: var(--lab); display: flex; gap: 10px; }
  .crumbs a { color: inherit; }
  .room h1 { font-size: clamp(42px, 5.4vw, 76px); margin: 10px 0 0; }
  .cols { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 22px; }
  .cols a { display: inline-flex; align-items: center; gap: 8px; font: var(--flst) var(--flw) 14px var(--fl); letter-spacing: .08em; text-decoration: none; padding: 4px 0; border-bottom: 1px solid transparent; }
  .cols a:hover { border-bottom-color: var(--accent); }
  .cols i, .grp h2 i { display: inline-block; width: 12px; height: 12px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); flex: none; }
  /* Filter bar, as on the old Designer grid: designs as pills, colours as dots. */
  .lf { margin-top: clamp(30px, 4vw, 50px); }
  .lf + .lf { margin-top: clamp(50px, 7vw, 90px); }
  .lf .gal--flow { margin-top: 0; }
  .lf__title { font-size: clamp(28px, 3vw, 42px); margin: 0 0 18px; }
  .lf__bar { position: sticky; top: 92px; z-index: 5; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding: 14px 18px; margin-bottom: clamp(22px, 3vw, 36px);
    border: 1px solid var(--line); border-radius: 18px; background: color-mix(in srgb, var(--ground) 90%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .lf__group { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .lf__group button { padding: .5em 1em; border-radius: 999px; border: 1px solid transparent; background: none; color: var(--ink); cursor: pointer;
    font: 600 18px var(--fl); letter-spacing: .03em; transition: background .3s, border-color .3s, color .3s; }
  .lf__group button:hover { border-color: var(--line); }
  .lf__group button.on { background: var(--primary); color: var(--ground); }
  .lf__group .dot { width: 30px; height: 30px; padding: 0; border-radius: 50%; background: var(--chip, var(--c)); position: relative;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.12), inset 0 -3px 6px rgba(0,0,0,.12), 0 1px 3px rgba(0,0,0,.12); transition: transform .25s; }
  .lf__group .dot:hover { transform: scale(1.12); }
  .lf__group .dot.on { background: var(--chip, var(--c)); }
  .lf__group .dot.on::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1.5px solid var(--primary); }
  .lf__group button.off { opacity: .28; }
  /* Customise: a placeholder for now; it takes you to "Made in your colour". */
  .lf__custom { margin-left: auto; padding: .45em 1.2em; border: 1px dashed var(--accent); border-radius: 999px; text-decoration: none; color: var(--ink); font: 600 18px var(--fl); letter-spacing: .06em; }
  .lf__custom:hover { background: var(--accent); color: #fff; border-style: solid; }
  .tile__img { position: relative; cursor: zoom-in; }
  .tile__img :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tile__extra { display: none; }
  .tile__more { position: absolute; right: 10px; bottom: 10px; padding: 5px 10px; border-radius: 999px; background: rgba(255,255,255,.88); color: var(--ink); font: 600 11px var(--fb); letter-spacing: .12em; text-transform: uppercase; opacity: 0; transition: opacity .3s; }
  .tile:hover .tile__more { opacity: 1; }
  .tile__row { display: flex; align-items: flex-start; justify-content: space-between; gap: 6px 10px; min-width: 0; flex-wrap: wrap; }
  .tile__custom { flex: none; padding: 3px 10px; border: 1px dashed color-mix(in srgb, var(--accent) 80%, transparent); border-radius: 999px; font: 600 11px var(--fb); letter-spacing: .1em; text-transform: uppercase; text-decoration: none; color: var(--lab); }
  .tile__custom:hover { border-style: solid; background: var(--accent); color: #fff; }
  .room__own { font: var(--flst) var(--flw) 14px var(--fl); letter-spacing: .1em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: 4px; margin-top: 16px; display: inline-block; }
  .cols__own i { background: conic-gradient(#c9a227, #a8553a, #6d2235, #56708f, #8fa98a, #c9a227); }
  .grp { padding-top: clamp(44px, 5vw, 70px); scroll-margin-top: 100px; }
  .grp__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 14px; margin-bottom: 18px; border-bottom: 1px solid var(--line); }
  .grp h2 { display: flex; align-items: center; gap: 14px; margin: 0; font-size: clamp(28px, 3vw, 42px); }
  .grp h2 i { width: 16px; height: 16px; }
  .grp__head span { font: var(--flst) var(--flw) 13px var(--fl); letter-spacing: .14em; text-transform: uppercase; color: var(--lab); }
  .gal > [hidden] { display: none; }
  .sty + .sty { margin-top: 34px; }
  .sty__h { display: flex; align-items: baseline; gap: 10px; margin: 0 0 14px; font: var(--flst) var(--flw) 17px var(--fl); letter-spacing: .12em; text-transform: uppercase; color: var(--ink); }
  .sty__h small { font: 600 11px var(--fb); letter-spacing: .1em; color: var(--lab); }
  .more { display: block; margin: 22px auto 0; background: none; border: 0; border-bottom: 1px solid var(--accent); padding: 6px 2px; cursor: pointer; color: var(--ink);
    font: var(--flst) var(--flw) 14px var(--fl); letter-spacing: .14em; text-transform: uppercase; }
  .room__jump { font: var(--flst) var(--flw) 15px var(--fl); letter-spacing: .12em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: 4px; white-space: nowrap; }

  /* Justified rows: every photo whole, in its own shape; the script sets widths so each row fills the line. */
  .gal { display: flex; flex-wrap: wrap; gap: 12px; }
  .gal--flow { gap: 26px 12px; margin-top: clamp(36px, 4vw, 56px); }
  .tile { display: flex; flex-direction: column; gap: 10px; width: calc(25% - 9px); text-decoration: none; color: var(--ink); scroll-margin-top: 110px; }
  .tile__img { display: block; overflow: hidden; background: var(--tint); }
  .tile__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .tile__img:hover img { transform: scale(1.03); }
  .tile__cap { display: flex; align-items: center; gap: 8px; min-width: 0; font: 600 15px var(--fl); letter-spacing: .1em; text-transform: uppercase; color: var(--lab); white-space: normal; text-decoration: none; }
  .tile__cap i { width: 12px; height: 12px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); flex: none; }

  /* Made in your colour */
  .own { background: var(--ground); border-block: 1px solid var(--line); padding: clamp(60px, 8vw, 110px) 0; scroll-margin-top: 84px; }
  .own__in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 96px); align-items: center; }
  .own__swatch { position: relative; margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: var(--dye, #8fa98a); transition: background .5s ease; }
  .own__swatch::after { content: ''; position: absolute; inset: 12px; border: 1px solid rgba(255,255,255,.55); pointer-events: none; }
  .own__swatch figcaption { position: absolute; left: 32px; bottom: 30px; color: #fff; display: grid; gap: 4px; transition: color .5s ease; }
  [data-light] .own__swatch figcaption { color: #1c1a18; }
  [data-light] .own__swatch::after { border-color: rgba(0,0,0,.18); }
  .own__swatch figcaption span { font: var(--fdw) clamp(28px, 2.6vw, 38px)/1 var(--fd); font-style: italic; }
  .own__swatch figcaption small { font: 600 11px var(--fb); letter-spacing: .2em; text-transform: uppercase; opacity: .85; }

  .own__form { display: grid; gap: 22px; justify-items: start; max-width: 480px; }
  .own__form .orn { margin-bottom: -6px; }
  .own__form h2 { font-size: clamp(34px, 3.6vw, 52px); margin: 0; }

  .shades { display: flex; flex-wrap: wrap; gap: 12px; }
  .shades button, .shades__own { width: 34px; height: 34px; border-radius: 50%; padding: 0; border: 0; cursor: pointer; background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); outline: 1px solid transparent; outline-offset: 4px; transition: outline-color .25s, transform .25s; }
  .shades button:hover, .shades__own:hover { transform: translateY(-2px); }
  .shades [aria-checked='true'], .shades__own.is-on { outline-color: var(--accent); }
  .shades__own { position: relative; display: block; background: conic-gradient(#c9a227, #a8553a, #6d2235, #56708f, #8fa98a, #c9a227); }
  .shades__own::after { content: '+'; position: absolute; inset: 7px; border-radius: 50%; background: var(--ground); display: grid; place-items: center; font: 300 17px/1 var(--fb); color: var(--ink); }
  .shades__own input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; cursor: pointer; }

  .own__field { width: 100%; }
  .own__field input { width: 100%; font: italic 400 19px var(--fd); padding: 10px 0; border: 0; border-bottom: 1px solid var(--accent); background: transparent; color: var(--ink); }
  .own__field input::placeholder { color: color-mix(in srgb, var(--ink) 45%, transparent); }
  .own__field input:focus { outline: none; border-bottom-width: 2px; }

  .own__terms { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); width: 100%; }
  .own__terms li { padding: 4px 14px; border-left: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); font-size: 13.5px; line-height: 1.45; color: color-mix(in srgb, var(--ink) 80%, transparent); }
  .own__terms li:first-child { border-left: 0; padding-left: 0; }
  .own__terms b { display: block; font: var(--flst) var(--flw) 13px var(--fl); letter-spacing: .14em; text-transform: uppercase; color: var(--lab); margin-bottom: 4px; }

  .pn { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 20px; padding-top: 40px; padding-bottom: 90px; }
  .pn a { text-decoration: none; display: grid; gap: 6px; font: var(--fdw) clamp(24px, 2.4vw, 34px)/1.1 var(--fd); }
  .pn a:last-child { text-align: right; }
  .pn small { font: 600 11px var(--fb); letter-spacing: .16em; text-transform: uppercase; color: var(--lab); }
  .pn .pn__all { font: 600 12px var(--fb); letter-spacing: .16em; text-transform: uppercase; border-bottom: 1px solid var(--accent); padding-bottom: 4px; }

  @media (max-width: 820px) { .own__in { grid-template-columns: 1fr; } .own__swatch { aspect-ratio: 4 / 3; } }
  @media (max-width: 640px) {
    .room__head { flex-direction: column; align-items: start; }
    .gal { gap: 8px; } .gal--flow { gap: 20px 8px; } .tile__cap { font-size: 11px; }
    .shades { gap: 9px; } .shades button, .shades__own { width: 30px; height: 30px; } .shades__own::after { inset: 6px; }
    .own__terms { grid-template-columns: 1fr; gap: 10px; }
    .own__terms li { border-left: 0; padding: 0 0 10px; border-bottom: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }
    .pn { grid-template-columns: 1fr 1fr; } .pn .pn__all { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
  }
</style>

<script>
  import { syncQuote } from '../../scripts/site';
  import { justifyAll } from '../../scripts/justify';
  const own = document.querySelector<HTMLElement>('[data-own]')!;
  const cat = own.dataset.cat!;
  const catName = own.dataset.catName!;
  const shades = [...own.querySelectorAll<HTMLButtonElement>('[data-shade]')];
  const ownPick = own.querySelector<HTMLElement>('.shades__own')!;
  const colorIn = own.querySelector<HTMLInputElement>('[data-own-color]')!;
  const pantoneIn = own.querySelector<HTMLInputElement>('[data-own-pantone]')!;
  const add = own.querySelector<HTMLButtonElement>('[data-own-add]')!;
  let hex = '#8FA98A';
  let label = 'Sage';

  function paint() {
    const pan = pantoneIn.value.trim();
    own.style.setProperty('--dye', hex);
    // Dark caption on light shades so the name stays readable.
    const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
    own.toggleAttribute('data-light', 0.299 * r + 0.587 * g + 0.114 * b > 165);
    own.querySelector('[data-own-name]')!.textContent = pan || label;
    own.querySelector('[data-own-hex]')!.textContent = pan ? `${label} · ${hex}` : hex;
    add.dataset.add = `custom-${cat}-${(pan || hex).toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
    add.dataset.name = `${catName} · ${pan ? `Pantone ${pan}` : `${label} ${hex}`}`;
    syncQuote();
  }
  const select = (btn: HTMLButtonElement | null) => {
    shades.forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
    ownPick.classList.toggle('is-on', !btn);
  };

  shades.forEach((b) => b.addEventListener('click', () => {
    hex = b.dataset.shade!.toUpperCase(); label = b.dataset.name!; select(b); paint();
  }));
  colorIn.addEventListener('input', () => { hex = colorIn.value.toUpperCase(); label = 'Your colour'; select(null); paint(); });
  pantoneIn.addEventListener('input', paint);
  paint();

  // Rows sized to the screen: taller on desktop, shorter on phones.
  const relayout = justifyAll('[data-justify]', { target: () => (innerWidth > 1100 ? 360 : innerWidth > 640 ? 290 : 230), maxPerRow: () => (innerWidth > 640 ? 5 : 2) });

  // Filter bars: narrow the items by design (data-d) and colour (data-c). Photo galleries show a page at a time.
  document.querySelectorAll<HTMLElement>('[data-lf]').forEach((box) => {
    const items = [...box.querySelectorAll<HTMLElement>('[data-lf-items] > [data-d]')];
    const gal = box.querySelector<HTMLElement>('[data-justify]');
    const more = box.querySelector<HTMLButtonElement>('[data-lf-more]');
    const page = Number(box.dataset.page) || Infinity;
    const f: Record<string, string> = { d: 'all', c: 'all' };
    let limit = page;
    const apply = () => {
      const match = items.filter((el) => (f.d === 'all' || el.dataset.d === f.d) && (f.c === 'all' || el.dataset.c === f.c));
      items.forEach((el) => (el.hidden = true));
      match.slice(0, limit).forEach((el) => (el.hidden = false));
      if (more) more.hidden = match.length <= limit;
      if (gal) relayout(gal);
      // Dim the options that would show nothing with the other filter as it is.
      box.querySelectorAll<HTMLElement>('[data-lf-key]').forEach((g) => {
        const key = g.dataset.lfKey!, other = key === 'd' ? 'c' : 'd';
        g.querySelectorAll<HTMLButtonElement>('button[data-v]:not([data-v="all"])').forEach((b) => {
          b.classList.toggle('off', !items.some((el) => el.dataset[key] === b.dataset.v && (f[other] === 'all' || el.dataset[other] === f[other])));
        });
      });
    };
    box.querySelectorAll<HTMLElement>('[data-lf-key]').forEach((g) => g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      g.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      f[g.dataset.lfKey!] = b.dataset.v!;
      limit = page;
      apply();
    }));
    more?.addEventListener('click', () => { limit += page; apply(); });
  });
</script>
