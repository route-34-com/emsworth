---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import HomeHero from '../components/HomeHero.astro';
import Pillars from '../components/Pillars.astro';
import Campaign from '../components/Campaign.astro';
import Portfolio from '../components/Portfolio.astro';
import DesignerTeaser from '../components/DesignerTeaser.astro';
import Tiers from '../components/Tiers.astro';
import Numbers from '../components/Numbers.astro';
import Reach from '../components/Reach.astro';
import CtaBand from '../components/CtaBand.astro';
import Contact from '../components/Contact.astro';
---
<Base title="Home" home>
  <Loader />
  <HomeHero />
  <Pillars />
  <Campaign />
  <Portfolio />
  <DesignerTeaser />
  <Tiers />
  <Numbers />
  <Reach />
  <CtaBand title="Design it. <em>We’ll weave it.</em>" text="Pick the size, colour, border, weight and embroidery — then send the spec straight to our sampling team." href="/tailor-made/" label="Open the Tailor-Made studio" />
  <Contact />
</Base>
