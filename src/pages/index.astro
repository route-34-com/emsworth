---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { collections, ranges, tiers, certifications, process } from '../data/catalogue';
import { pick, inFolder, closeups } from '../data/shoot';

import heroA from '../assets/hero/robe-recline.jpg';
import colourSmile from '../assets/hero/colours-smile.jpg';
import colourHug from '../assets/hero/colours-hug.jpg';
import bandedRolls from '../assets/hero/banded-rolls.jpg';
const signature = pick('web-banner', 'j8a0879-edit');
const stack = pick('ranges/feather-nest/hand', 'j8a0828-edit');
const location = pick('outdoor/s1', 'j8a1104-edit');
const feel = closeups.bath.slice(0, 10);
const feelFull = await Promise.all(feel.map((src) => getImage({ src, width: 1600, format: 'webp' })));
const patterns = inFolder('product-closeup').filter((_, i) => [0, 7, 12, 16, 20, 26].includes(i));
const tailor = { title: 'Tailor-made', kicker: 'Your crest, woven in', image: pick('product-closeup', 'j8a2346'), href: '/tailor-made/' };
---
<Base title="Emsworth Hospitality · Hotel textiles, woven for the finest rooms" overHero>

  <!-- Hero: one photograph, edge to edge, and one line -->
  <section class="hero">
    <Image class="hero__img" src={heroA} alt="Guest reclining in a white Emsworth robe beside a throw embroidered with EMSWORTH"
      widths={[800, 1400, 2000, 2800]} sizes="100vw" loading="eager" fetchpriority="high" />
    <h1 class="hero__line">The Feel<br/><em>Comes First</em></h1>
    <a class="hero__cue" href="#colour" aria-label="Scroll down"><span></span></a>
  </section>

  <!-- Studio panels: each fills the screen and slides over the one before -->
  <div class="panels" id="colour">
    <section class="panel panel--smile">
      <Image class="panel__img" src={colourSmile} alt="Smiling guest in a white robe holding a stack of charcoal, navy, rust, olive, ivory and white towels"
        widths={[800, 1400, 2000, 2800]} sizes="100vw" />
      <div class="panel__txt wrap">
        <span class="label">Colour, to your Pantone</span>
        <h2>Every shade,<br/><em>every room.</em></h2>
        <p>Charcoal, navy, rust, olive, ivory and optical white, or matched to your own Pantone: piece dyed from 500 pieces, yarn dyed from 1,000.</p>
        <a class="btn btn--line" href="/lookbook/bath/">See the colours</a>
      </div>
    </section>
    <section class="panel panel--hug">
      <Image class="panel__img" src={colourHug} alt="Guest hugging a stack of soft coloured Emsworth towels with her eyes closed"
        widths={[800, 1400, 2000, 2800]} sizes="100vw" />
      <div class="panel__txt wrap">
        <span class="label">Bath linen</span>
        <h2>Softness,<br/><em>with a memory.</em></h2>
        <p>Zero-twist and double-loop terry from 420 to 700 GSM, built to stay soft and open through the commercial laundry, wash after wash.</p>
        <a class="btn btn--line" href="/collections/bath/">Bath linen specifications</a>
      </div>
    </section>
    <section class="panel panel--rolls">
      <div class="panel__txt wrap">
        <span class="label">Presentation</span>
        <h2>The grammar<br/><em>of fabric.</em></h2>
        <p>Rolled, banded and labelled as it arrives at your property: kraft belly bands, woven labels and gift boxes to your own artwork.</p>
        <a class="btn btn--line" href="/tailor-made/">Packaging &amp; branding</a>
      </div>
      <Image class="panel__img" src={bandedRolls} alt="Smiling model holding four rolled Emsworth towels in kraft and white belly bands"
        widths={[700, 1100, 1600, 1866]} sizes="(max-width: 760px) 100vw, 50vw" />
    </section>
  </div>

  <!-- Introduction -->
  <section class="sec intro" id="intro">
    <div class="wrap intro__grid">
      <div class="reveal">
        <span class="orn"></span>
        <span class="label">The Emsworth way</span>
        <h2>Woven in Tamil Nadu.<br/><em>Delivered across the Gulf.</em></h2>
        <p class="lead">Emsworth brings the looms of the Christy textile group in Tiruchengode to hotel procurement teams in Dubai and beyond: one partner from specification and sampling to production, shipping and replenishment.</p>
        <dl class="facts">
          <div><dt>180 tonnes</dt><dd>woven a month on Itema and Stäubli looms</dd></div>
          <div><dt>Since 2004</dt><dd>making terry, linen and made-ups</dd></div>
          <div><dt>4 certifications</dt><dd>ISO 9001, GOTS, OEKO-TEX, SA8000</dd></div>
        </dl>
      </div>
      <div class="intro__pics reveal">
        <figure class="intro__a inset"><Image src={signature} alt="Guest in a white robe and head towel holding a stack of coloured Emsworth towels" widths={[600, 1000, 1400]} sizes="(max-width: 860px) 90vw, 45vw" /></figure>
        <figure class="intro__b"><Image src={stack} alt="A slate-blue Feather Nest towel held up by the corner" widths={[360, 600]} sizes="(max-width: 860px) 50vw, 20vw" /></figure>
      </div>
    </div>
  </section>

  <!-- Collections -->
  <section class="sec sec--ground">
    <div class="wrap">
      <div class="sec__head sec__head--center reveal">
        <span class="orn"></span>
        <span class="label">The collections</span>
        <h2>Every textile a guest touches</h2>
      </div>
      <div class="cols" data-rows>
        {[...collections.map((c) => ({ title: c.name, kicker: c.kicker, image: c.image, href: `/collections/${c.slug}/` })), tailor].map((c, i) => (
          <a class="col reveal" href={c.href} style={`--d:${i * 60}ms`} data-ar={(c.image.width / c.image.height).toFixed(4)}>
            <div class="col__img inset" style={`aspect-ratio: ${c.image.width} / ${c.image.height}`}><Image src={c.image} alt="" widths={[420, 720, 1100]} sizes="(max-width: 700px) 92vw, 45vw" /></div>
            <span class="label">{c.kicker}</span>
            <h3>{c.title}</h3>
            <span class="link">Explore</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tiers -->
  <section class="sec sec--primary on-dark tiers">
    <div class="wrap">
      <div class="sec__head reveal">
        <span class="label">Bath linen</span>
        <h2>Choose the tier.<br/><em>Then choose the item.</em></h2>
        <p>Every tier carries the same ladder (bath sheet, bath towel, hand, face and mat), so a specification compares like for like. Mix by room category.</p>
      </div>
      <div class="tiers__grid">
        {tiers.map((t) => (
          <a class="tier reveal" href={`/collections/bath/#${t.id}`}>
            <span class="tier__gsm">{t.gsm}<small> GSM</small></span>
            <span class="tier__bar" style={`--w:${(t.gsm / 700) * 100}%`}></span>
            <h3>{t.name}</h3>
            <p>{t.construction}</p>
            <p class="tier__for">{t.for}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Ranges -->
  <section class="sec">
    <div class="wrap">
      <div class="sec__head reveal">
        <span class="orn"></span>
        <span class="label">The ranges</span>
        <h2>Six ranges, <em>photographed in full</em></h2>
        <p class="lead">From hotel white to safari jacquard. Every range can be dyed to your Pantone and finished with your crest.</p>
      </div>
      <div class="rgs" data-rows>
        {ranges.map((r) => (
          <a class="rg reveal" href={`/ranges/${r.slug}/`} data-ar={(r.lead.width / r.lead.height).toFixed(4)}>
            <div class="rg__img" style={`aspect-ratio: ${r.lead.width} / ${r.lead.height}`}><Image src={r.lead} alt={`${r.name}: ${r.colours}`} widths={[420, 800, 1100]} sizes="(max-width: 700px) 92vw, 45vw" /></div>
            <div class="rg__txt">
              <span class="label">{r.tag}</span>
              <h3>{r.name}</h3>
              <p>{r.line}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The feel -->
  <section class="sec sec--ground feel">
    <div class="wrap">
      <div class="sec__head reveal">
        <span class="label">Hotel white, up close</span>
        <h2>The feel <em>comes first.</em></h2>
        <p class="lead">Borders, piles and weaves photographed at the scale a guest’s hand meets them. Tap any to look closer.</p>
      </div>
    </div>
    <div class="strip" data-gallery>
      {feel.map((src, i) => (
        <a href={feelFull[i].src} data-full data-cap="Hotel white close-ups">
          <Image src={src} alt={`White Emsworth terry close-up ${i + 1}`} widths={[420, 700]} sizes="(max-width: 700px) 70vw, 28vw" loading="lazy" />
        </a>
      ))}
    </div>
  </section>

  <!-- Tailor-made -->
  <section class="sec tm">
    <div class="wrap tm__grid">
      <div class="tm__mosaic reveal" data-rows data-rows-max="3">
        {patterns.map((p) => p.src).map((src) => <span data-ar={(src.width / src.height).toFixed(4)} style={`aspect-ratio: ${src.width} / ${src.height}`}><Image src={src} alt="Emsworth jacquard pattern with woven label" widths={[300, 520, 800]} sizes="(max-width: 860px) 50vw, 24vw" /></span>)}
      </div>
      <div class="reveal">
        <span class="orn"></span>
        <span class="label">Tailor-made</span>
        <h2>Your crest, <em>woven in.</em></h2>
        <p class="lead">Every article can be built to your own dimension, border, colour and branding: jacquard logos woven into the border, embroidery, woven labels, Pantone-matched dyes and yarn-dyed stripes.</p>
        <a class="btn btn--line" href="/tailor-made/">See what we can weave</a>
      </div>
    </div>
  </section>

  <!-- On location -->
  <section class="loc">
    <Image src={location} alt="Guest wrapping herself in a white Emsworth bath sheet in dappled sunlight" widths={[700, 1200, 1800]} sizes="100vw" />
    <div class="loc__q wrap reveal">
      <p>“A towel is judged in the hand, in the first second. So that is where we start.”</p>
    </div>
  </section>

  <!-- Heritage -->
  <section class="sec sec--dark on-dark her">
    <div class="wrap">
      <div class="her__grid">
        <div class="sec__head reveal">
          <span class="label">Heritage &amp; manufacturing</span>
          <h2>One partner, <em>from loom to linen room.</em></h2>
          <p>Spinning, weaving, dyeing, finishing, cutting, embroidery and packing under direct control, with a zero liquid discharge effluent plant. Coordinated from Dubai, so your team has one regional point of contact.</p>
          <a class="link" href="/heritage/">Our heritage</a>
        </div>
        <ul class="certs reveal">{certifications.map(([n, d]) => <li><b>{n}</b><span>{d}</span></li>)}</ul>
      </div>
      <ol class="steps">
        {process.map(([t, d], i) => <li class="reveal"><span>{String(i + 1).padStart(2, '0')}</span><b>{t}</b><p>{d}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- Close -->
  <section class="sec close">
    <div class="wrap close__in frame reveal">
      <span class="orn"></span>
      <span class="label">UAE · GCC · Middle East · Africa</span>
      <h2>Send us the specification.</h2>
      <p class="lead">We will send back a sample, a lead time we intend to keep, and the certificates before you ask for them.</p>
      <div class="close__ctas"><a class="btn" href="/request-a-quote/">Request a quote</a><a class="btn btn--line" href="/lookbook/">Browse the lookbook</a></div>
    </div>
  </section>
</Base>

<style>
  /* Hero: the photograph is the page. Only a faint neutral shade where the header and the line sit. */
  .hero { position: relative; height: 100svh; min-height: 560px; overflow: hidden; background: #2a211b; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% 40%; animation: settle 2.4s cubic-bezier(.2,.6,.3,1) both; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background:
    linear-gradient(180deg, rgba(0,0,0,.32), transparent 18%),
    linear-gradient(90deg, rgba(0,0,0,.38), transparent 42%); }
  .hero__line { position: absolute; z-index: 2; left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); top: 50%; translate: 0 -50%; margin: 0;
    font: var(--fdw) clamp(44px, 5.4vw, 86px)/1.02 var(--fd); color: #fff; letter-spacing: .005em; animation: rise 1.4s .5s cubic-bezier(.2,.7,.2,1) both; }
  .hero__line em { font-style: italic; }
  @keyframes settle { from { transform: scale(1.04); } to { transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .hero__cue { position: absolute; z-index: 2; right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); bottom: clamp(40px, 7vh, 76px); width: 1px; height: 48px; background: rgba(255,255,255,.35); overflow: hidden; }
  .hero__cue span { position: absolute; inset: 0; background: #fff; animation: drip 2.4s ease-in-out infinite; transform-origin: top; }
  @keyframes drip { 0% { transform: scaleY(0); } 55% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero__img, .hero__line, .hero__cue span { animation: none; } }

  /* Studio panels: sticky, so each photo covers the screen and the next slides over it */
  .panel { position: sticky; top: 0; height: 100svh; min-height: 560px; overflow: hidden; display: grid; align-items: center; }
  .panel--smile { background: #cbc7c6; z-index: 1; }
  .panel--hug { background: #cecbcb; z-index: 2; box-shadow: 0 -30px 60px -30px rgba(0,0,0,.35); }
  .panel--rolls { background: radial-gradient(90% 100% at 72% 45%, #c7c5c5, #bdbab9 70%, #b5b2b1); z-index: 3; box-shadow: 0 -30px 60px -30px rgba(0,0,0,.35); grid-template-columns: 1fr 1fr; }
  .panel__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .panel--smile .panel__img { object-position: 70% 40%; }
  .panel--hug .panel__img { object-position: 66% 40%; }
  .panel--rolls .panel__img { position: relative; inset: auto; grid-column: 2; grid-row: 1; height: 100svh; min-height: 560px; object-fit: cover; object-position: 50% 30%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 88%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 88%, transparent 100%); }
  .panel__txt { position: relative; z-index: 1; width: 100%; display: grid; gap: 18px; justify-items: start; }
  .panel__txt > * { max-width: 470px; }
  .panel__txt > p { max-width: 400px; }
  .panel--rolls .panel__txt { grid-column: 1; grid-row: 1; padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
  .panel h2 { font-size: clamp(46px, 5.6vw, 84px); line-height: 1.02; }
  .panel--hug h2 { max-width: 520px; }
  .panel p { margin: 0; font-size: clamp(17px, 1.4vw, 20px); color: var(--ink); }
  .panel .label { color: color-mix(in srgb, var(--lab) 80%, #000); }

  /* Intro */
  .intro { padding-bottom: clamp(48px, 6vw, 80px); }
  .intro + .sec { padding-top: clamp(48px, 6vw, 80px); }
  .intro__grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(36px, 6vw, 100px); align-items: center; }
  .intro h2 { font-size: clamp(38px, 4.8vw, 66px); margin: 12px 0 22px; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 36px 0 0; border-top: 4px double var(--line); padding-top: 22px; }
  .facts dt { font: 400 clamp(22px, 2.2vw, 30px)/1.1 var(--fd); color: var(--primary); }
  .facts dd { margin: 6px 0 0; font-size: 14px; color: var(--soft); }
  .intro__pics { position: relative; padding-bottom: 22%; }
  .intro__pics figure { margin: 0; overflow: hidden; }
  .intro__a img { display: block; width: 100%; height: auto; }
  .intro__b { position: absolute; width: 38%; left: -6%; bottom: 0; border: 8px solid var(--paper); box-shadow: 0 30px 60px -30px rgba(0,0,0,.45); }
  .intro__b img { display: block; width: 100%; height: auto; }

  /* Collections */
  /* Collections, ranges and patterns: each photo whole, in rows the script scales to fill the width (scripts/justify.ts). */
  .cols { display: flex; flex-wrap: wrap; gap: clamp(30px, 3vw, 44px) clamp(18px, 2.4vw, 34px); }
  .col { display: grid; gap: 8px; justify-items: start; align-content: start; width: calc(33.333% - 23px); text-decoration: none; transition-delay: var(--d); }
  .col__img { width: 100%; overflow: hidden; margin-bottom: 10px; }
  .col__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .col:hover .col__img img { transform: scale(1.04); }
  .col h3 { font-size: clamp(28px, 2.6vw, 38px); }
  .col .link { margin-top: 6px; }

  /* Tiers */
  .tiers__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; background: color-mix(in srgb, var(--accent) 35%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); }
  .tier { background: var(--primary); padding: clamp(22px, 2.6vw, 36px); text-decoration: none; display: grid; gap: 10px; align-content: start; transition: background .3s; }
  .tier:hover { background: color-mix(in srgb, var(--primary) 85%, var(--accent)); }
  .tier__gsm { font: 400 clamp(46px, 5vw, 72px)/1 var(--fd); color: var(--accent); }
  .tier__gsm small { font-size: .3em; letter-spacing: .14em; }
  .tier__bar { height: 3px; background: color-mix(in srgb, var(--ground) 14%, transparent); position: relative; margin: 6px 0 10px; }
  .tier__bar::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--w); background: var(--accent); }
  .tier h3 { font-size: 30px; }
  .tier p { margin: 0; font-size: 15px; }
  .tier__for { opacity: .75; }

  /* Ranges */
  .rgs { display: flex; flex-wrap: wrap; gap: clamp(30px, 3vw, 44px) clamp(18px, 2.4vw, 34px); }
  .rg { text-decoration: none; display: grid; gap: 14px; align-content: start; width: calc(33.333% - 23px); }
  .rg__img { width: 100%; overflow: hidden; background: var(--tint); }
  .rg__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .rg:hover .rg__img img { transform: scale(1.04); }
  .rg h3 { font-size: clamp(30px, 3vw, 44px); margin: 6px 0 8px; }
  .rg p { margin: 0; color: var(--soft); }

  /* Feel strip */
  .strip { display: grid; grid-auto-flow: column; grid-auto-columns: max-content; gap: 12px; overflow-x: auto; padding: 0 var(--gutter) 14px; scroll-padding-inline: var(--gutter); scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .strip a { scroll-snap-align: start; overflow: hidden; cursor: zoom-in; height: clamp(220px, 26vw, 380px); }
  .strip img { display: block; height: 100%; width: auto; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .strip a:hover img { transform: scale(1.05); }

  /* Tailor-made */
  .tm__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 100px); align-items: center; }
  .tm h2 { font-size: clamp(38px, 4.8vw, 66px); margin: 12px 0 20px; }
  .tm .lead { margin-bottom: 28px; }
  .tm__mosaic { display: flex; flex-wrap: wrap; gap: 8px; }
  .tm__mosaic > span { display: block; width: calc(33.333% - 6px); overflow: hidden; }
  .tm__mosaic img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* On location */
  .loc { position: relative; height: min(88svh, 860px); overflow: hidden; color: var(--ground); }
  .loc img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; }
  .loc::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, color-mix(in srgb, var(--dark) 80%, transparent), transparent 55%); }
  .loc__q { position: absolute; z-index: 1; left: 0; right: 0; bottom: clamp(40px, 8vw, 90px); }
  .loc__q p { margin: 0; max-width: 820px; font: italic 400 clamp(28px, 3.6vw, 52px)/1.15 var(--fd); }

  /* Heritage */
  .her__grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(30px, 6vw, 90px); align-items: start; }
  .her .sec__head p { margin: 0 0 8px; }
  .certs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .certs li { display: grid; grid-template-columns: 1fr 1.2fr; gap: 14px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .certs b { font: 400 22px var(--fd); color: var(--ground); }
  .certs span { font-size: 14px; }
  .steps { list-style: none; margin: clamp(40px, 6vw, 80px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; counter-reset: s; }
  .steps li { border-top: 2px solid var(--accent); padding-top: 16px; }
  .steps span { font: 400 30px var(--fd); color: var(--accent); }
  .steps b { display: block; font: 400 22px var(--fd); color: var(--ground); margin: 6px 0; }
  .steps p { margin: 0; font-size: 14px; }

  /* Close */
  .close__in { text-align: center; display: grid; justify-items: center; gap: 14px; padding: clamp(40px, 6vw, 80px); }
  .close h2 { font-size: clamp(40px, 5.4vw, 76px); }
  .close .lead { text-align: center; margin: 0 auto; }
  .close__ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 12px; }

  @media (max-width: 1020px) {
    .steps { grid-template-columns: repeat(3, 1fr); row-gap: 30px; }
    .tiers__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .intro__grid, .tm__grid, .her__grid { grid-template-columns: 1fr; }
    .intro__pics { margin-top: 10px; }
  }
  @media (max-width: 600px) {
    .facts { grid-template-columns: 1fr; gap: 14px; }
    .steps { grid-template-columns: 1fr 1fr; }
    .tiers__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 760px) {
    .hero__img { object-position: 76% 40%; }
    .hero::before { background: linear-gradient(180deg, rgba(0,0,0,.32), transparent 16%); }
    .hero__line { font-size: 42px; color: #1c1a18; text-shadow: 0 0 24px rgba(255,255,255,.6); } /* on a phone the line sits over the white robe */
    .hero__cue { display: none; }
    .panel { grid-template-columns: 1fr; grid-template-rows: 56% 44%; align-items: start; }
    .panel__img, .panel--rolls .panel__img { position: relative; inset: auto; grid-row: 1; grid-column: 1; width: 100%; height: 100%; min-height: 0; -webkit-mask-image: none; mask-image: none; }
    .panel--smile .panel__img { object-position: 64% 40%; }
    .panel--hug .panel__img { object-position: 62% 36%; }
    .panel--rolls .panel__img { object-position: 50% 22%; }
    .panel__txt, .panel--rolls .panel__txt { grid-row: 2; grid-column: 1; padding: 22px var(--gutter) 28px; gap: 12px; }
    .panel p { font-size: 15.5px; }
    .panel h2 { font-size: 38px; }
  }
</style>

<script>
  import { justifyAll } from '../scripts/justify';
  // Rows of whole photographs: up to three to a row on desktop, two on a tablet, one on a phone (patterns stay three).
  justifyAll('.cols[data-rows], .rgs[data-rows]', { target: () => (innerWidth > 1100 ? 480 : 380), maxPerRow: () => (innerWidth > 860 ? 3 : innerWidth > 600 ? 2 : 1) });
  justifyAll('.tm__mosaic[data-rows]', { target: () => (innerWidth > 860 ? 200 : 170), maxPerRow: () => 3 });
</script>

