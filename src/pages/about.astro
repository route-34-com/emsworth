---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Seals from '../components/Seals.astro';
import { getImage } from 'astro:assets';
import DriftWall from '../components/reactbits/DriftWall.jsx';
import { certifications, process } from '../data/catalogue';
import { pick, inFolder } from '../data/shoot';

// How we pack: banded rolls in the garden, the band, tag and card, and the shirt box.
import rollsGarden from '../assets/hero/rolls-garden.jpg';
const pack = [rollsGarden, pick('slipper-robe', 'j8a2550-edit'), pick('product-sku', 'j8a2310')];
const outdoor = inFolder('outdoor', true).map((p) => p.src);
const banners = inFolder('web-banner').map((p) => p.src);
const wall = await Promise.all([...new Set([...outdoor, ...banners])].map(async (src) => ({ image: (await getImage({ src, width: 520, format: 'webp' })).src, title: '' })));
const facilities = [
  ['Weaving', 'High-speed warping, Itema looms and Stäubli jacquard, producing around 180 tonnes a month.'],
  ['Dyeing', 'A modern soft-flow dyeing unit, with our own share in a state-sponsored common effluent treatment plant for zero liquid discharge.'],
  ['Finishing', 'Mario Crosta finishing machinery and Schmale length hemming.'],
  ['Making up', 'A high-tech sewing unit with imported machines, and a dedicated garment unit for robes.'],
];
const markets = ['Hotels & resorts', 'Hospitality developments', 'Serviced residences', 'Restaurants & F&B', 'Pool & leisure', 'Corporate & institutional'];
---
<Base title="About · Emsworth Hospitality" overHero
  description="Emsworth Hospitality in Dubai, backed by the Christy textile group's mills in Tiruchengode, Tamil Nadu: facilities, certifications and how a project runs.">
  <PageHero image={pick('web-banner', 'j8a0886-edit')} alt="Smiling guest hugging four rolled Emsworth towels in their belly bands" focus="50% 16%"
    whole kicker="About Emsworth" title="From loom<br/><em>to linen room.</em>"
    intro="A Dubai partner for hotel procurement, backed by a textile group that has woven terry, linen and made-ups in Tamil Nadu since 2004." />

  <section class="sec">
    <div class="wrap two">
      <div class="reveal">
        <span class="orn"></span>
        <span class="label">Two companies, one partner</span>
        <h2>Regional service.<br/><em>Manufacturing depth.</em></h2>
      </div>
      <div class="reveal copy">
        <p class="lead"><b>Emsworth Hospitality LLC FZ</b> is based in Dubai and serves hotel groups, resorts, developers, consultants and operators across the UAE, GCC, Middle East and Africa.</p>
        <p>Manufacturing sits with <b>Christy Textile Products Pvt. Ltd.</b>, a Star Export House in Tiruchengode, Tamil Nadu, led by Managing Director N. Mohanasundaram, a textile technologist with more than forty years in the industry. Christy supplies retailers, hotels and institutional buyers across the Middle East, Europe, the UK, the US, Latin America, Japan, Australia and Asia Pacific.</p>
        <p>That structure lets a procurement team work with a UAE-based partner while reaching established manufacturing, from specification and sampling to production, logistics and delivery.</p>
      </div>
    </div>
  </section>

  <section class="sec sec--ground">
    <div class="wrap">
      <div class="sec__head reveal"><span class="label">Facilities</span><h2>Under one roof, <em>under our control</em></h2></div>
      <div class="fac">
        {facilities.map(([t, d], i) => <div class="frame reveal"><span class="fac__n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <Seals />

  <!-- How we pack -->
  <section class="sec sec--ground pack" id="pack">
    <div class="wrap pack__grid">
      <div class="reveal">
        <span class="label">How we pack</span>
        <h2>Rolled, banded, <em>ready for the room.</em></h2>
        <p class="lead">Every piece leaves the mill folded or rolled, wrapped in a kraft or white belly band with your name on it, tagged with its care label and packed by room type, so housekeeping can put it straight into service.</p>
        <ul class="pack__list">
          <li><b>Belly bands</b>Kraft or white, printed with your logo</li>
          <li><b>Swing tags &amp; cards</b>Care, composition and a thank-you note</li>
          <li><b>Cartons</b>Packed and labelled by room type and floor</li>
        </ul>
      </div>
      <div class="pack__pics reveal">{pack.map((src) => <span><Image src={src} alt="Emsworth packaging: belly bands, tags and rolled towels" widths={[500, 900, 1300]} sizes="(max-width: 860px) 45vw, 24vw" /></span>)}</div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head reveal"><span class="label">How a project runs</span><h2>Six steps, <em>one point of contact</em></h2></div>
      <ol class="steps">{process.map(([t, d], i) => <li class="reveal"><span>{String(i + 1).padStart(2, '0')}</span><b>{t}</b><p>{d}</p></li>)}</ol>
      <div class="mk reveal">
        <span class="label">Who we serve</span>
        <ul>{markets.map((m) => <li>{m}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- The location and campaign shoot as a ReactBits Drift Wall: columns of photos drifting past in perspective. -->
  <section class="sec sec--ground drift">
    <div class="wrap">
      <div class="sec__head reveal"><span class="label">On location &amp; campaign</span><h2>Emsworth <em>in the sun</em></h2></div>
    </div>
    <div class="drift__wall"><DriftWall client:only="react" items={wall} columns={10} tileWidth={250} tileHeight={300} gap={14} radius={3}
      tilt={0} turn={0} speed={24} variance={0.4} parallax={0} lift={0} fade={0.12} dim={0.96} overlayColor="#141c30" /></div>
  </section>
</Base>

<style>
  /* Heading and wall together fill exactly one screen below the header; the photos just drift, nothing to hover or click. */
  .sec.drift { display: flex; flex-direction: column; height: calc(100svh - 84px); min-height: 520px; padding-top: clamp(24px, 3.5vh, 44px); padding-bottom: 0; }
  .drift > .wrap { width: 100%; }
  .drift .sec__head { margin-bottom: 0; }
  .drift__wall { flex: 1; min-height: 0; margin-top: 12px; pointer-events: none; }
  .drift__wall :global(img) { object-position: 50% 20%; }
  /* Straight on, edge to edge: no side fade, just a soft edge under the heading. */
  .drift__wall :global(.drift-wall) { -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 5%); mask-image: linear-gradient(180deg, transparent 0, #000 5%); }
  /* Safari: only the wall itself is 3D. Giving every tile its own 3D layer (~200 of them) made Safari drop photos. */
  .drift__wall :global(.drift-wall__col), .drift__wall :global(.drift-wall__track), .drift__wall :global(.drift-wall__tile) { transform-style: flat; }
  .drift__wall :global(.drift-wall__inner) { transform: none; }
  .drift__wall :global(.drift-wall__overlay) { opacity: .1; }
  .drift__wall :global(.drift-wall__inner) { background: var(--tint); } /* tiles crop near the top so faces stay in */
  .pack__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(30px, 5vw, 80px); align-items: center; }
  .pack h2 { font-size: clamp(36px, 4vw, 58px); margin: 12px 0 16px; }
  .pack__list { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 12px; }
  .pack__list li { display: grid; gap: 2px; padding-top: 12px; border-top: 1px solid var(--line); }
  .pack__list b { font: 600 13px var(--fl); letter-spacing: .14em; text-transform: uppercase; color: var(--lab); }
  .pack__pics { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 12px; height: min(68svh, 620px); }
  .pack__pics span { overflow: hidden; }
  .pack__pics span:first-child { grid-row: span 2; }
  .pack__pics :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .pack__pics span:first-child :global(img) { object-position: 40% 50%; }
  @media (max-width: 860px) { .pack__grid { grid-template-columns: 1fr; } .pack__pics { height: 70vw; } }
  .two { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(30px, 6vw, 90px); }
  .two h2 { font-size: clamp(38px, 4.6vw, 64px); margin-top: 12px; }
  .copy p { margin: 0 0 16px; }
  .copy b { color: var(--primary); }
  .fac { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .fac__n { font: 400 40px/1 var(--fd); color: var(--accent); }
  .fac h3 { font-size: 28px; margin: 12px 0 8px; }
  .fac p { margin: 0; font-size: 15px; color: var(--soft); }
  .certs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .certs li { border-top: 2px solid var(--accent); padding-top: 16px; display: grid; gap: 6px; }
  .certs b { font: 400 26px var(--fd); color: var(--ground); }
  .tests { margin: 40px 0 0; max-width: 80ch; font-size: 15px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; }
  .steps li { border-top: 2px solid var(--accent); padding-top: 16px; }
  .steps span { font: 400 30px var(--fd); color: var(--accent); }
  .steps b { display: block; font: 400 22px var(--fd); color: var(--primary); margin: 6px 0; }
  .steps p { margin: 0; font-size: 14px; color: var(--soft); }
  .mk { margin-top: 70px; display: grid; gap: 16px; }
  .mk ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .mk li { font: 400 20px var(--fd); color: var(--primary); padding: 10px 18px; border: 1px solid var(--line); }
  .camp { margin-top: 70px; }
  @media (max-width: 1020px) { .fac, .certs { grid-template-columns: repeat(2, 1fr); } .steps { grid-template-columns: repeat(3, 1fr); row-gap: 30px; } }
  @media (max-width: 700px) { .two, .fac, .certs { grid-template-columns: 1fr; } .steps { grid-template-columns: 1fr 1fr; } }
</style>
