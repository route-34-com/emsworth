---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pillars from '../components/Pillars.astro';
import Numbers from '../components/Numbers.astro';
import Process from '../components/Process.astro';
import Creds from '../components/Creds.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="About" description="Emsworth Hospitality LLC FZ is a Dubai-based hospitality supply partner backed by the manufacturing of Christy Textile Products, Tamil Nadu, since 2004.">
  <PageHero kicker="About Emsworth" title="A Dubai partner with <em>its own mill.</em>" lede="Regional hospitality support, backed by textile manufacturing in Tamil Nadu since 2004." img="banner/banner-2" alt="Model with Emsworth jacquard towels on a line" />

  <section class="story" data-theme-section="sand">
    <p class="story__lead split">Emsworth connects manufacturing capability with the practical requirements of hotel procurement — from <em>specification and sampling</em> to production, logistics and delivery.</p>
    <div class="story__cols">
      <p>Emsworth Hospitality LLC FZ is a Dubai-based hospitality solutions company serving hotel groups, resorts, developers, consultants, contractors, restaurants and operators across the Middle East and Africa.</p>
      <p>It is backed by Christy Textile Products Pvt. Ltd., incorporated in 2004 in Tiruchengode, Tamil Nadu — a manufacturer and exporter of terry towels, bed linen, table linen, bathrobes, blankets and made-ups, including organic cotton. Spinning, weaving, dyeing, finishing, embroidery and packing sit under direct control.</p>
    </div>
  </section>

  <Pillars />
  <Numbers />
  <Process />
  <Creds />
  <CtaBand title="Let’s talk about <em>your property.</em>" text="One regional partner for linen, towels, robes and amenities." href="/contact/" label="Get in touch" />
</Base>
