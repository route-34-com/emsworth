---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { collections } from '../../data/catalogue';
import { pick } from '../../data/shoot';
---
<Base title="Collections · Emsworth Hospitality" overHero
  description="Bath, bed, table, pool and spa linen, robes and slippers for hotels: catalogue specifications, sizes, MOQs and lead times.">
  <PageHero image={pick('web-banner', 'j8a0877-edit')} alt="Model in a white robe holding a stack of coloured Emsworth towels" focus="70% 40%"
    kicker="The collections" title="Every textile<br/><em>a guest touches.</em>"
    intro="Five collections with full catalogue specifications. Every article can be built to your own dimension, border, colour and branding." />

  <section class="sec">
    <div class="wrap list">
      {collections.map((c, i) => (
        <a class:list={['row reveal', { 'row--flip': i % 2 }]} href={`/collections/${c.slug}/`}>
          <div class="row__img inset"><Image src={c.image} alt={c.alt} widths={[520, 900]} sizes="(max-width: 820px) 92vw, 45vw" /></div>
          <div class="row__txt">
            <span class="row__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="label">{c.kicker}</span>
            <h2>{c.name}</h2>
            <p>{c.intro}</p>
            <p class="row__progs">{c.programs.map((p) => p.name).join(' · ')}</p>
            <span class="link">View specifications</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .list { display: grid; gap: clamp(60px, 9vw, 120px); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 6vw, 90px); align-items: center; text-decoration: none; }
  .row--flip .row__img { order: 2; }
  .row__img { overflow: hidden; }
  .row__img img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .row:hover .row__img img { transform: scale(1.03); }
  .row__txt { display: grid; gap: 12px; justify-items: start; }
  .row__n { font: 400 54px/1 var(--fd); color: var(--accent); }
  .row h2 { font-size: clamp(40px, 4.6vw, 64px); }
  .row p { margin: 0; color: var(--soft); max-width: 48ch; }
  .row__progs { font: var(--flst) 14px var(--fl); color: var(--lab) !important; }
  @media (max-width: 820px) { .row { grid-template-columns: 1fr; } .row--flip .row__img { order: 0; } }
</style>
