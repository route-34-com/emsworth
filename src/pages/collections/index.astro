---
import Base from '../../layouts/Base.astro';
import heroes from '../../data/heroes.json';
import PageHero from '../../components/PageHero.astro';
import collectionsHero from '../../assets/hero/collections-sit.jpg';
import { getImage } from 'astro:assets';
import { collections } from '../../data/catalogue';
import { CATEGORIES, tagged } from '../../data/colours';
import ProductShowcase from '../../components/ProductShowcase.jsx';
import StackCards from '../../components/StackCards.jsx';
import { pick } from '../../data/shoot';

// The products for the showcase: each with its lookbook cover, photo count and lookbook link.
const products = await Promise.all(CATEGORIES.map(async (c) => ({
  name: c.name, href: `/lookbook/${c.id}/`, count: tagged.filter((p) => p.cat === c.id).length,
  image: (await getImage({ src: pick(...c.cover), width: 900, format: 'webp' })).src,
  thumb: (await getImage({ src: pick(...c.cover), width: 480, format: 'webp' })).src, // small copies keep the orbit smooth
})));
// The five collections as cards that pin and stack while you scroll.
const widths = [600, 1000, 1500];
const cards = await Promise.all(collections.map(async (c) => {
  const imgs = await Promise.all(widths.map((width) => getImage({ src: c.image, width, format: 'webp' })));
  return { href: `/collections/${c.slug}/`, kicker: c.kicker, title: c.name, text: c.intro, meta: c.programs.map((p) => p.name).join(' · '),
    cta: 'View specifications', ar: (c.image.width / c.image.height).toFixed(4), alt: c.alt,
    src: imgs[1].src, srcset: imgs.map((x, i) => `${x.src} ${widths[i]}w`).join(', ') };
}));
---
<Base title="Collections · Emsworth Hospitality" overHero
  description="Bath, bed, table, pool and spa linen, robes and slippers for hotels: catalogue specifications, sizes, MOQs and lead times.">
  <PageHero tune={(heroes as any).collections} image={collectionsHero} alt="Guest in a green head towel holding a banded Emsworth towel, beside rolled towels on a lounge chair" focus="50% 0%" plain
    kicker="The collections" title="Every textile<br/><em>a guest touches.</em>"
    intro="Five collections with full catalogue specifications. Every article can be built to your own dimension, border, colour and branding." />

  <section class="sec">
    <div class="wrap"><StackCards client:load items={cards} gap={16} /></div>
  </section>

  <!-- Every product we photographed (not only the towel ranges), in one of three displays the visitor can switch between. -->
  <section class="sec sec--ground" id="products">
    <div class="wrap">
      <div class="sec__head reveal">
        <span class="label">Every product</span>
        <h2>Robes to glass cloths, <em>in full colour.</em></h2>
        <p class="lead">Bathrobes, towels, bath mats, slippers, bed and table linen, glass cloths and uniform shirts. Choose one to see every photograph of it.</p>
      </div>
      <ProductShowcase client:only="react" items={products} modes={["orbit"]} />
    </div>
  </section>
</Base>


