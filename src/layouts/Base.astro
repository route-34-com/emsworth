---
import '../styles/global.css';
import '../styles/main-port.css';
import '../styles/hero-tune.css';
import logo from '../assets/logo.svg?raw';
import SiteClose from '../components/SiteClose.astro';
import PageCurtain from '../components/PageCurtain.astro';

interface Props { title: string; description?: string; overHero?: boolean; clearHeader?: boolean; cta?: boolean }
const {
  title,
  description = 'Hotel textiles woven in Tamil Nadu and supplied from Dubai: bath, bed, table, pool and spa linen, robes and slippers, made to your specification.',
  overHero = false,
  clearHeader = false,
  cta = true,
} = Astro.props;
const nav = [
  ['Collections', '/collections/'], ['Designer', '/designer/'], ['The Stay', '/the-stay/'], ['Lookbook', '/lookbook/'], ['About', '/about/'],
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-palette="navybeige" data-theme="split">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <script is:inline>try{if(sessionStorage.getItem('emsTrans')==='1')document.documentElement.classList.add('is-trans')}catch(e){}</script>
  <!-- Apply the saved design choice before first paint, so there is no flash. -->
  <script is:inline>
    (function () {
      var d = {};
      try { d = JSON.parse(localStorage.getItem('emsworth-design') || '{}'); } catch (e) {}
      var q = new URLSearchParams(location.search);
      // Only the palette is a choice now (type and theme are fixed); an old saved type or theme is ignored.
      var p = q.get('palette') || d.palette;
      if (p === 'teal' || p === 'navybeige') document.documentElement.dataset.palette = p;
    })();
  </script>
</head>
<body>
  <!-- The line mark from the main site, used by the ported call-to-action bands. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><symbol id="loop" viewBox="0 0 270 420"><path d="M105,122 C103,100 85,90 70,93 C55,96 45,110 47,130 C48,137 50,142 52,145 C35,140 15,145 11,165 C7,190 30,210 60,213 C95,216 140,198 160,165 C175,140 168,110 148,106 C125,101 108,120 104,150 C100,185 104,230 125,275 C150,330 200,370 262,405" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></symbol></defs></svg>
  <PageCurtain />
  <a class="skip" href="#main">Skip to content</a>
  <header class:list={['hdr', { 'hdr--over': overHero, 'hdr--clear': clearHeader }]} data-hdr>
    <div class="hdr__in wrap">
      <a class="hdr__logo" href="/" aria-label="Emsworth Hospitality, home"><Fragment set:html={logo} /></a>
      <nav class="hdr__nav" aria-label="Main">
        {nav.map(([t, h]) => <a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{t}</a>)}
      </nav>
      <a class="hdr__quote" href="/request-a-quote/">Quote <span data-count>0</span></a>
      <button class="hdr__burger" aria-label="Menu" aria-expanded="false" data-burger><span></span><span></span></button>
    </div>
  </header>
  <div class="hdr__panel" data-panel aria-hidden="true" inert>
    <nav class="hdr__menu" aria-label="Mobile">
      {nav.map(([t, h], i) => <a href={h} style={`--i:${i}`} aria-current={path.startsWith(h) ? 'page' : undefined}><span>{t}</span><i aria-hidden="true">→</i></a>)}
    </nav>
    <div class="hdr__menufoot" style={`--i:${nav.length}`}>
      <a class="btn" href="/request-a-quote/">Request a quote <span aria-hidden="true">→</span></a>
      <a class="hdr__mail" href="mailto:info@emsworthhospitality.com">info@emsworthhospitality.com</a>
      <span class="hdr__regions">UAE · GCC · Middle East · Africa</span>
    </div>
  </div>


  <main id="main"><slot /></main>

  <SiteClose cta={cta} />

  <!-- Lightbox for every gallery -->
  <dialog class="lb" data-lb aria-label="Photo viewer">
    <img data-lb-img alt="" />
    <p class="lb__cap" data-lb-cap></p>
    <button class="lb__btn lb__close" data-lb-close aria-label="Close">✕</button>
    <button class="lb__btn lb__prev" data-lb-prev aria-label="Previous">‹</button>
    <button class="lb__btn lb__next" data-lb-next aria-label="Next">›</button>
  </dialog>

  <div class="toast" data-toast role="status" aria-live="polite"></div>

  <!-- Design switcher: lets the client compare the shortlisted directions on the real site. -->
  <div class="ds" data-ds>
    <button class="ds__toggle" data-ds-toggle aria-expanded="false">Design</button>
    <div class="ds__panel" data-ds-panel hidden>
      <p class="ds__h">Palette</p>
      <div class="ds__row" data-ds-group="palette">
        <button data-v="navybeige">Navy, Beige &amp; Gold</button><button data-v="teal">Teal &amp; Sand</button>
      </div>
    </div>
  </div>
</body>
</html>

<script>
  import '../scripts/site.ts';
  import '../scripts/main-port.js';
</script>

<style is:global>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: var(--ground); padding: 8px 14px; }
  .skip:focus { left: 8px; }

  /* Header */
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--primary); color: var(--ground); transition: background .35s, box-shadow .35s; }
  .hdr--over { position: fixed; left: 0; right: 0; background: transparent; }
  .hdr--over.hdr--solid, .hdr.hdr--open { background: var(--primary); box-shadow: 0 10px 30px -20px rgba(0,0,0,.5); }
  /* clearHeader: the header never turns into a bar; the page can switch its words dark (.hdr--ink) over light backgrounds. */
  .hdr--clear.hdr--solid { background: transparent; box-shadow: none; }
  .hdr--clear { transition: color .4s; }
  .hdr--clear.hdr--ink:not(.hdr--open) { color: var(--primary); }
  .hdr--clear.hdr--ink:not(.hdr--open) .hdr__logo { color: var(--primary); }
  .hdr--clear.hdr--ink:not(.hdr--open) .hdr__burger span { background: var(--primary); }
  .hdr__in { display: flex; align-items: center; gap: 28px; height: 84px; }
  .hdr__logo { display: block; color: var(--ground); width: clamp(150px, 15vw, 196px); flex: none; }
  .hdr__logo svg, .ftr__logo svg { display: block; width: 100%; height: auto; }
  .hdr__nav { display: flex; gap: clamp(16px, 2.2vw, 34px); margin-left: auto; }
  .hdr__nav a, .hdr__panel a { font: 700 14px var(--fmenu); letter-spacing: .14em; text-transform: uppercase; text-decoration: none; padding: 6px 0; border-bottom: 1px solid transparent; }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { border-bottom-color: var(--accent); }
  .hdr__quote { font: 700 11px var(--fmenu); letter-spacing: .16em; text-transform: uppercase; text-decoration: none; border: 1px solid var(--accent); padding: 10px 14px; display: inline-flex; gap: 8px; align-items: center; }
  .hdr__quote { transition: background .35s, color .35s, transform .45s cubic-bezier(.22, 1, .36, 1); }
  .hdr__quote:hover { background: var(--accent); color: var(--dark); transform: translateY(-1px); }
  .hdr__quote:hover span { background: var(--dark); color: var(--ground); }
  .hdr__quote span { transition: background .35s, color .35s; background: var(--accent); color: var(--dark); border-radius: 999px; min-width: 20px; height: 20px; display: inline-grid; place-items: center; font-size: 10px; letter-spacing: 0; }
  .hdr__burger { display: none; width: 44px; height: 44px; background: none; border: 0; padding: 10px; cursor: pointer; }
  .hdr__burger span { display: block; height: 1.5px; background: var(--ground); margin: 6px 0; transition: transform .3s; }
  .hdr--open .hdr__burger span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .hdr--open .hdr__burger span:last-child { transform: translateY(-4px) rotate(-45deg); }
  /* Mobile menu: full-screen panel that opens as a circle from the burger, links rising in one after another. */
  .hdr__panel { position: fixed; inset: 0; z-index: 49; display: flex; flex-direction: column; justify-content: space-between; gap: 32px;
    padding: 110px var(--gutter) max(32px, env(safe-area-inset-bottom)); background: var(--dark); color: var(--ground);
    clip-path: circle(0 at calc(100% - 44px) 36px); visibility: hidden; transition: clip-path .8s cubic-bezier(.76, 0, .24, 1), visibility 0s .8s; overflow-y: auto; }
  .hdr__panel.is-open { clip-path: circle(150% at calc(100% - 44px) 36px); visibility: visible; transition: clip-path .9s cubic-bezier(.76, 0, .24, 1), visibility 0s; }
  .hdr__menu { display: grid; }
  .hdr__menu a { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; text-decoration: none; color: var(--ground);
    font: 800 clamp(30px, 9vw, 44px)/1.05 var(--fb); letter-spacing: -.03em; text-transform: none; border-bottom: 1px solid color-mix(in srgb, var(--ground) 14%, transparent);
    opacity: 0; transform: translateY(28px); transition: opacity .4s, transform .4s; }
  .hdr__menu a i { font-style: normal; font-size: .6em; color: var(--accent); transform: translateX(-6px); transition: transform .4s cubic-bezier(.22, 1, .36, 1); }
  .hdr__menu a:hover i, .hdr__menu a:focus-visible i { transform: none; }
  .hdr__menu a[aria-current='page'] span { color: var(--accent); }
  .hdr__menufoot { display: grid; gap: 14px; justify-items: start; opacity: 0; transform: translateY(20px); transition: opacity .4s, transform .4s; }
  .hdr__mail { color: color-mix(in srgb, var(--ground) 80%, transparent); text-decoration: none; font-size: 15px; }
  .hdr__regions { font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: color-mix(in srgb, var(--ground) 50%, transparent); }
  .is-open .hdr__menu a, .is-open .hdr__menufoot { opacity: 1; transform: none; transition: opacity .7s cubic-bezier(.22, 1, .36, 1) calc(.3s + var(--i) * .07s), transform .7s cubic-bezier(.22, 1, .36, 1) calc(.3s + var(--i) * .07s); }
  .hdr--open { background: transparent !important; box-shadow: none !important; }
  @media (min-width: 1021px) { .hdr__panel { display: none; } }
  @media (prefers-reduced-motion: reduce) { .hdr__panel, .hdr__panel.is-open { transition: none; } }
  @media (max-width: 1020px) {
    .hdr__nav { display: none; }
    .hdr__quote { margin-left: auto; }
    .hdr__burger { display: block; }
    .hdr__in { height: 70px; gap: 12px; }
  }

  /* Footer */
  .ftr { background: var(--dark); color: var(--on-dark); padding: 80px 0 40px; }
  .ftr__top { display: grid; grid-template-columns: 1fr 1.4fr; gap: 60px; margin-bottom: 50px; }
  .ftr__logo { display: block; color: var(--ground); width: 220px; margin-bottom: 18px; }
  .ftr__tag { font: italic 400 26px var(--fd); color: var(--ground); margin: 0 0 8px; }
  .ftr__brand p { max-width: 40ch; margin: 0 0 24px; }
  .ftr__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .ftr__cols div { display: grid; gap: 10px; align-content: start; }
  .ftr__cols .label { margin-bottom: 6px; }
  .ftr__cols a { text-decoration: none; font-size: 15px; overflow-wrap: anywhere; }
  .ftr__cols a:hover { color: var(--accent); }
  .ftr__fine { font-size: 13px; opacity: .7; margin: 26px 0 0; max-width: 90ch; }
  @media (max-width: 860px) { .ftr__top, .ftr__cols { grid-template-columns: 1fr; gap: 34px; } }

  /* Lightbox */
  .lb { padding: 0; border: 0; max-width: none; max-height: none; width: 100vw; height: 100dvh; background: rgba(8,10,18,.94); color: #fff; }
  .lb[open] { display: grid; place-items: center; }
  .lb::backdrop { background: rgba(0,0,0,.6); }
  .lb img { max-width: min(92vw, 1500px); max-height: 84dvh; width: auto; height: auto; object-fit: contain; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
  .lb__cap { position: absolute; bottom: 18px; left: 0; right: 0; text-align: center; font: var(--flst) 13px var(--fl); letter-spacing: .14em; text-transform: uppercase; opacity: .75; margin: 0; }
  .lb__btn { position: absolute; background: rgba(255,255,255,.08); color: #fff; border: 1px solid rgba(255,255,255,.25); width: 52px; height: 52px; border-radius: 50%; font-size: 26px; cursor: pointer; }
  .lb__btn:hover { background: rgba(255,255,255,.18); }
  .lb__close { top: 18px; right: 18px; font-size: 18px; }
  .lb__prev { left: 18px; top: 50%; transform: translateY(-50%); }
  .lb__next { right: 18px; top: 50%; transform: translateY(-50%); }

  /* Toast */
  .toast { position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 140%); background: var(--primary); color: var(--ground); padding: 14px 22px; font-size: 14px; z-index: 60; transition: transform .4s cubic-bezier(.2,.7,.2,1); border-top: 2px solid var(--accent); max-width: calc(100vw - 32px); }
  .toast { opacity: 0; visibility: hidden; }
  .toast.show { transform: translate(-50%, 0); opacity: 1; visibility: visible; }
  .toast a { color: var(--accent); }

  /* Design switcher */
  .ds { position: fixed; left: 16px; bottom: 16px; z-index: 55; font-family: var(--fb); }
  .ds__toggle { background: var(--ground); color: var(--primary); border: 1px solid var(--line); border-radius: 999px; padding: 10px 16px; font: 700 11px var(--fb); letter-spacing: .14em; text-transform: uppercase; cursor: pointer; box-shadow: 0 10px 30px -14px rgba(0,0,0,.5); }
  .ds__panel { position: absolute; left: 0; bottom: 52px; width: min(330px, calc(100vw - 32px)); background: var(--ground); color: var(--ink); border: 1px solid var(--line); padding: 16px; box-shadow: 0 24px 60px -24px rgba(0,0,0,.55); }
  .ds__h { margin: 0 0 6px; font: 700 10px var(--fb); letter-spacing: .14em; text-transform: uppercase; color: var(--lab); }
  .ds__row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .ds__row:last-child { margin-bottom: 0; }
  .ds__row button { font: 600 12.5px var(--fb); padding: 7px 11px; border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); background: none; color: var(--ink); cursor: pointer; }
  .ds__row button[aria-pressed='true'] { background: var(--primary); color: var(--ground); border-color: var(--primary); }
  @media (max-width: 700px) { .ds { left: auto; right: 12px; bottom: 12px; } .ds__panel { left: auto; right: 0; } .ds__toggle { padding: 8px 12px; font-size: 10px; } }
</style>
