---
// Three studio scenes, pinned while you scroll. Each new scene dissolves in over the last: it fades up while its photo
// settles from a slight zoom, and the scene behind eases back and fades away. Quiet, like a page turning in a catalogue.
import { getImage } from 'astro:assets';
import colourSmile from '../assets/hero/colours-smile.jpg';
import colourHug from '../assets/hero/colours-hug.jpg';
import bandedRolls from '../assets/hero/banded-rolls.jpg';

const pic = async (src: ImageMetadata, widths: number[]) => {
  const imgs = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp' })));
  return { src: imgs.at(-2)!.src, srcset: imgs.map((x, i) => `${x.src} ${widths[i]}w`).join(', ') };
};
const scenes = [
  { id: 'smile', img: await pic(colourSmile, [800, 1400, 2000, 2800]), focus: '70% 40%', mfocus: '64% 40%',
    alt: 'Smiling guest in a white robe holding a stack of charcoal, navy, rust, olive, ivory and white towels',
    label: 'Colour, to your Pantone', h: 'Every shade,<br/><em>every room.</em>',
    p: 'Charcoal, navy, rust, olive, ivory and optical white, or matched to your own Pantone: piece dyed from 500 pieces, yarn dyed from 1,000.',
    cta: ['See the colours', '/lookbook/bath/'] },
  { id: 'hug', img: await pic(colourHug, [800, 1400, 2000, 2800]), focus: '66% 40%', mfocus: '62% 36%',
    alt: 'Guest hugging a stack of soft coloured Emsworth towels with her eyes closed',
    label: 'Bath linen', h: 'Softness,<br/><em>with a memory.</em>',
    p: 'Zero-twist and double-loop terry from 420 to 700 GSM, built to stay soft and open through the commercial laundry, wash after wash.',
    cta: ['Bath linen specifications', '/collections/bath/'] },
  { id: 'rolls', img: await pic(bandedRolls, [700, 1100, 1600, 1866]), focus: '50% 30%', mfocus: '50% 22%',
    alt: 'Smiling model holding four rolled Emsworth towels in kraft and white belly bands',
    label: 'Presentation', h: 'The grammar<br/><em>of fabric.</em>',
    p: 'Rolled, banded and labelled as it arrives at your property: kraft belly bands, woven labels and gift boxes to your own artwork.',
    cta: ['Packaging & branding', '/about/#pack'] },
];
---
<section class="weave" id="colour" data-weave>
  <div class="weave__stage">
    {scenes.map((s, i) => {
      const face = (
        <span class={`weave__face weave__face--${s.id}`}>
          <img src={s.img.src} srcset={s.img.srcset} sizes={s.id === 'rolls' ? '(max-width: 760px) 100vw, 50vw' : '100vw'} alt={i === 0 ? s.alt : ''}
            style={`--fx: ${s.focus}; --mfx: ${s.mfocus}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </span>
      );
      return (
        <div class={`weave__scene weave__scene--${s.id}`} data-scene={i} role="group" aria-label={s.label}>
          <div class="weave__whole" data-fold>{face}</div>
          <div class="weave__copy wrap" data-copy={i}>
            <span class="label">{s.label}</span>
            <h2 data-no-split set:html={s.h} />
            <p>{s.p}</p>
            <a class="btn btn--line" href={s.cta[1]}>{s.cta[0]}</a>
          </div>
        </div>
      );
    })}
    <p class="weave__count" aria-hidden="true"><b data-weave-n>01</b><span><i data-weave-bar></i></span>0{scenes.length}</p>
  </div>
</section>

<style>
  /* Three screens of scroll; the stage stays put while the scenes are woven over each other. */
  .weave { position: relative; height: 320svh; background: #cbc7c6; }
  .weave__stage { position: sticky; top: 0; height: 100svh; min-height: 560px; overflow: hidden;  }
  .weave__scene { position: absolute; inset: 0; }
  .weave__whole { position: absolute; inset: 0; }

  .weave__whole { overflow: hidden; will-change: opacity; }
  .weave__whole::after { content: ''; position: absolute; inset: 0; background: #0b1020; opacity: var(--dim, 0); pointer-events: none; }
  .weave__whole .weave__face { position: absolute; inset: 0; }
  .weave__face { display: block; background: #cbc7c6; }
  .weave__face img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--fx); }
  .weave__face--hug { background: #cecbcb; }
  .weave__face--rolls { background: radial-gradient(90% 100% at 72% 45%, #c7c5c5, #bdbab9 70%, #b5b2b1); }
  /* Desktop: the photo stands at full height against the right edge, pushed a little past it, so the person sits in the
     right part of the screen; its left edge fades into the studio grey behind the words. */
  @media (min-width: 761px) {
    .weave__face--smile img, .weave__face--hug img { left: auto; right: calc(max(100svh, 560px) * -0.12); width: calc(max(100svh, 560px) * 1.5);
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%); mask-image: linear-gradient(90deg, transparent 0, #000 22%); }
  }
  .weave__face--rolls img { left: 56%; width: 44%; object-position: var(--fx);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 88%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 22%, #000 88%, transparent 100%); }

  .weave__copy { position: absolute; inset: 0; z-index: 2; display: grid; align-content: center; padding-top: clamp(60px, 12vh, 140px); gap: 18px; justify-items: start; pointer-events: none; }
  .weave__copy > * { max-width: 620px; pointer-events: auto; }
  .weave__copy > p { max-width: 520px; margin: 0; font-size: clamp(18px, 1.65vw, 24px); color: var(--ink); }
  .weave__copy h2 { font-size: clamp(50px, 6.8vw, 108px); line-height: 1.02; }
  .weave__copy .label { color: color-mix(in srgb, var(--lab) 80%, #000); }

  .weave__count { position: absolute; z-index: 3; right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); bottom: clamp(28px, 5vh, 52px); margin: 0;
    display: flex; align-items: center; gap: 12px; font: 600 12px var(--fb); letter-spacing: .16em; color: color-mix(in srgb, var(--ink) 70%, transparent); }
  .weave__count b { color: var(--ink); }
  .weave__count span { position: relative; width: 72px; height: 1px; background: color-mix(in srgb, var(--ink) 25%, transparent); overflow: hidden; }
  .weave__count i { position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(0); }

  /* Phone: picture on top, words underneath. */
  @media (max-width: 760px) {
    .weave__face img, .weave__face--rolls img { left: 0; width: 100%; height: 58%; object-position: var(--mfx); -webkit-mask-image: none; mask-image: none; }
    .weave__face { background: var(--ground) !important; }
    .weave__copy { align-content: end; padding-bottom: 64px; gap: 12px; }
    .weave__copy h2 { font-size: 38px; }
    .weave__copy > p { font-size: 15.5px; }
    .weave__count { bottom: 22px; }
  }

  /* Without motion: the three scenes simply stack, each one screen tall. */
  .weave.is-static { height: auto; }
  .weave.is-static .weave__stage { position: relative; height: auto; overflow: visible; }
  .weave.is-static .weave__scene { position: relative; height: 100svh; min-height: 560px; overflow: hidden; }
  .weave.is-static .weave__count { display: none; }
  .weave.is-static .weave__whole::after { display: none; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-weave]')!;
  const scenes = [...root.querySelectorAll<HTMLElement>('[data-scene]')];
  const copies = scenes.map((s) => s.querySelector<HTMLElement>('[data-copy]')!);

  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    root.classList.add('is-static');
  } else {
    const num = root.querySelector('[data-weave-n]')!;
    const bar = root.querySelector('[data-weave-bar]')!;
    // Later scenes start folded shut along the middle, their photos a little zoomed; their words start hidden.
    const folds = scenes.map((s) => s.querySelector<HTMLElement>('[data-fold]')!);
    gsap.set(folds.slice(1), { autoAlpha: 0 });
    gsap.set(folds.slice(1).map((f) => f.querySelector('img')), { scale: 1.08 });
    gsap.set(copies.slice(1), { autoAlpha: 0, y: 40 });

    const tl = gsap.timeline({ defaults: { ease: 'none' } });
    tl.to({}, { duration: 0.35 }); // a moment on the first scene
    scenes.slice(1).forEach((_, i) => {
      const fold = folds[i + 1];
      tl.to(copies[i], { autoAlpha: 0, y: -30, duration: 0.25, ease: 'power1.in' })
        .to(fold, { autoAlpha: 1, duration: 0.8, ease: 'power1.inOut' }, '<0.05')
        .to(fold.querySelector('img'), { scale: 1, duration: 1, ease: 'power2.out' }, '<')
        .to(folds[i].querySelector('img'), { scale: 0.97, duration: 0.8, ease: 'power1.inOut' }, '<')
        .to(copies[i + 1], { autoAlpha: 1, y: 0, duration: 0.3, ease: 'power2.out' }, '<0.3')
        .to({}, { duration: 0.35 });
    });
    ScrollTrigger.create({
      trigger: root, start: 'top top', end: 'bottom bottom', scrub: 0.6, animation: tl,
      onUpdate: (st) => {
        gsap.set(bar, { scaleX: st.progress });
        num.textContent = '0' + (Math.min(scenes.length - 1, Math.floor(st.progress * scenes.length * 0.999)) + 1);
      },
    });
  }
</script>
