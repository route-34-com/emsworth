---
<section class="process" id="process" data-theme-section="sand">
  <div class="process__pin">
    <div class="process__head">
      <h2 class="split">One thread, <em>start to finish.</em></h2>
    </div>
    <div class="process__stage">
      <svg class="process__svg" viewBox="0 0 1600 400" preserveAspectRatio="none" aria-hidden="true">
        <path id="procBase" d="M0,200 C120,80 220,80 300,200 S480,320 560,200 S740,80 820,200 S1000,320 1080,200 S1260,80 1340,200 S1520,320 1600,200" fill="none"/>
        <path id="procLine" d="M0,200 C120,80 220,80 300,200 S480,320 560,200 S740,80 820,200 S1000,320 1080,200 S1260,80 1340,200 S1520,320 1600,200" fill="none"/>
      </svg>
      <ol class="process__steps" id="procSteps">
        <li><h4>Requirement</h4><p>Scope, quantities, specifications, budget and programme.</p></li>
        <li><h4>Proposal</h4><p>Products, materials, finishes and sourcing options.</p></li>
        <li><h4>Sample</h4><p>Samples, lab dips, CADs, mock-ups and approvals.</p></li>
        <li><h4>Production</h4><p>Built to approved specification, progress tracked.</p></li>
        <li><h4>Logistics</h4><p>Documentation, shipment planning, UAE delivery.</p></li>
        <li><h4>Handover</h4><p>Delivery, replenishment and project close-out.</p></li>
      </ol>
    </div>
  </div>
</section>
