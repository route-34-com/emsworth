---
import Pic from './Pic.astro';
interface Props { kicker: string; title: string; lede?: string; img: string; alt: string; pos?: string; crumbs?: { href: string; label: string }[]; }
const { kicker, title, lede, img, alt, pos = '50% 50%', crumbs = [] } = Astro.props;
---
<section class="phero" data-theme-section="teal">
  <div class="phero__media" style={`--pos:${pos}`}><Pic src={img} alt={alt} sizes="100vw" eager /></div>
  <div class="phero__shade"></div>
  <div class="phero__content">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((c) => <Fragment><a href={c.href}>{c.label}</a><span>/</span></Fragment>)}
      </nav>
    )}
    <p class="phero__kicker">{kicker}</p>
    <h1 class="phero__title" set:html={title} />
    {lede && <p class="phero__lede">{lede}</p>}
  </div>
  <div class="phero__scroll" aria-hidden="true"><i></i></div>
</section>
