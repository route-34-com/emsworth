---
interface Props { cta?: boolean }
const { cta = true } = Astro.props;
const EMAIL = 'info@emsworthhospitality.com';
---
<div class="mb sclose">
  {cta && (
    <section class="ctaband" data-theme-section="teal">
      <svg class="ctaband__loop" viewBox="0 0 270 420" aria-hidden="true"><use href="#loop"/></svg>
      <div class="ctaband__inner">
        <h2 class="split">Tell us about <em>the project.</em></h2>
        <p>Rooms, quantities and timeline — we’ll come back with a proposal, samples and a lead time we intend to keep.</p>
        <a href="/request-a-quote/" class="btn btn--sand magnetic"><span>Start a project</span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    </section>
  )}

  <footer class="sfoot">
    <div class="sfoot__top">
      <div><h5>Emsworth Hospitality LLC FZ</h5><p>Dubai, United Arab Emirates<br>UAE · GCC · Middle East · Africa</p></div>
      <div><h5>Explore</h5><p><a href="/collections/">Collections</a><br><a href="/designer/">Designer Collection</a><br><a href="/lookbook/">Lookbook</a><br><a href="/about/">About</a></p></div>
      <div><h5>Enquiries</h5><p><a href={`mailto:${EMAIL}`}>{EMAIL}</a><br>www.emsworthhospitality.com</p></div>
      <div><h5>Manufacturing</h5><p>Christy Textile Products Pvt. Ltd.<br>Tiruchengode, Tamil Nadu, India<br>ISO 9001 · GOTS · OEKO-TEX · SA8000</p></div>
    </div>
    <a class="sfoot__word" href="/" aria-label="Emsworth Hospitality home"><img src="/assets/img/logo.png" alt="Emsworth" /></a>
    <div class="sfoot__bottom"><span>© 2026 Emsworth Hospitality LLC FZ</span><span>Integrated Hospitality Supply &amp; Project Solutions</span><a href="#main" data-top>Back to top ↑</a></div>
  </footer>
</div>

<style>
  .sfoot { position: relative; padding: clamp(70px, 10vh, 120px) var(--gutter) 30px; background: #072826; color: #FFEDE0; overflow: hidden; }
  .sfoot__top { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; padding-bottom: clamp(50px, 8vh, 90px); }
  .sfoot h5 { font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: #C6A57A; margin: 0 0 12px; font-weight: 800; }
  .sfoot p { margin: 0; color: rgba(255, 237, 224, .7); font-size: .95rem; line-height: 1.6; }
  .sfoot a { color: inherit; text-decoration: none; }
  .sfoot p a:hover { color: #FFEDE0; }
  .sfoot__word { display: block; overflow: hidden; color: #FFEDE0; }
  .sfoot__word img { display: block; width: 100%; height: auto; }
  .sfoot__bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 30px; font-size: .82rem; color: rgba(255, 237, 224, .5); }
  .sfoot__bottom a:hover { color: #FFEDE0; }
  @media (max-width: 820px) { .sfoot__top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .sfoot__top { grid-template-columns: 1fr; } }
</style>
