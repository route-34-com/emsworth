---
import Pic from './Pic.astro';
---
<section class="campaign" data-theme-section="sand">
  <div class="campaign__head">
    <h2 class="split">Made to be <em>felt.</em></h2>
    <p>Terry, waffle and jacquard from our own looms — finished, branded and folded for the property that orders them.</p>
  </div>
  <div class="campaign__grid">
    <figure class="cimg cimg--a" data-speed="-0.06"><Pic src="lifestyle/shoot-18" alt="Guest in an Emsworth bathrobe beside a branded cushion" sizes="(max-width: 820px) 100vw, 58vw" /></figure>
    <figure class="cimg cimg--b" data-speed="0.1"><Pic src="lifestyle/shoot-10" alt="Sage green Emsworth bath towel" sizes="(max-width: 820px) 50vw, 40vw" /></figure>
    <figure class="cimg cimg--c" data-speed="0.04"><Pic src="lifestyle/shoot-20" alt="Striped jacquard pool towels on a lounger" sizes="(max-width: 820px) 50vw, 40vw" /></figure>
    <figure class="cimg cimg--d" data-speed="-0.1"><Pic src="lifestyle/shoot-05" alt="Woven white bath mat" sizes="(max-width: 820px) 100vw, 50vw" /></figure>
  </div>
</section>
