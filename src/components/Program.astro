---
// One catalogue program: name, line, add-to-quote and its specification table.
import type { Program } from '../data/catalogue';
interface Props { p: Program; group: string; n: number }
const { p, group, n } = Astro.props;
---
<article class="prog frame reveal" id={p.id}>
  <header>
    <span class="prog__n">{String(n).padStart(2, '0')}</span>
    <h3>{p.name}</h3>
    <p>{p.line}</p>
    <button class="add" data-add={p.id} data-name={p.name} data-group={group}>+ Add to quote</button>
  </header>
  <table>
    <caption class="sr">Specification for {p.name}</caption>
    <tbody>{p.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
  </table>
</article>

<style>
  .prog { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(22px, 4vw, 60px); }
  .prog header { display: grid; align-content: start; gap: 12px; justify-items: start; }
  .prog__n { font: 400 44px/1 var(--fd); color: var(--accent); }
  .prog h3 { font-size: clamp(32px, 3.4vw, 46px); }
  .prog p { margin: 0 0 6px; color: var(--soft); }
  table { width: 100%; border-collapse: collapse; font-size: 15px; align-self: start; }
  th, td { text-align: left; padding: 12px 0; border-bottom: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); vertical-align: top; }
  th { width: 34%; font: var(--flst) var(--flw) 12px var(--fl); letter-spacing: .14em; text-transform: uppercase; color: var(--lab); padding-top: 14px; padding-right: 14px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 820px) { .prog { grid-template-columns: 1fr; } }
</style>
