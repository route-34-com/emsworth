---
---
<section class="hero" data-theme-section="teal">
  <canvas class="hero__cloth" id="cloth"></canvas>
  <div class="hero__shade"></div>
  <div class="hero__content">
    <p class="eyebrow hero__eyebrow"><span class="dot"></span> Hospitality Division · Dubai, United Arab Emirates</p>
    <h1 class="hero__title">
      <span class="line"><span class="line__in">The Feel</span></span>
      <span class="line"><span class="line__in">Comes <em>First.</em></span></span>
    </h1>
    <div class="hero__foot">
      <p class="hero__lede">Towels, linen, robes and amenities, woven in our own mills and delivered across the Gulf by a team in Dubai.</p>
      <div class="hero__ctas">
        <a href="/tailor-made/" class="btn btn--sand magnetic"><span>Design your towel</span></a>
        <a href="/collection/" class="btn btn--ghost magnetic"><span>Explore collections</span></a>
      </div>
    </div>
  </div>
  <div class="hero__badge" aria-hidden="true">
    <svg viewBox="0 0 200 200"><text><textPath href="#circ">Engineered comfort · Built to survive the laundry · </textPath></text></svg>
    <svg class="hero__badge-loop"><use href="#loop"/></svg>
  </div>
  <div class="hero__hint"><span>Move to touch the cloth</span><i></i></div>
  <div class="hero__regions">UAE · GCC · Middle East · Africa</div>
</section>
